<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MonitorApp.Client.Core.ViewModels"
             xmlns:ctl="using:MonitorApp.Client.Desktop.Controls"
             x:Class="MonitorApp.Client.Desktop.Views.HistoryView" x:DataType="vm:HistoryViewModel">
  <DockPanel Margin="8">
    <StackPanel DockPanel.Dock="Top" Spacing="6">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Name="SubjectLabel" Text="Subject" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding Picker.Subjects}" SelectedItem="{Binding Picker.SelectedSubject}" MinWidth="160" AutomationProperties.LabeledBy="{Binding #SubjectLabel}" />
        <TextBlock Name="SignalLabel" Text="Signal" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding Picker.Signals}" SelectedItem="{Binding Picker.SelectedSignal}" MinWidth="160" AutomationProperties.LabeledBy="{Binding #SignalLabel}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Name="RangeLabel" Text="Range" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" MinWidth="160" AutomationProperties.LabeledBy="{Binding #RangeLabel}" />
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsCustom}">
          <TextBlock Name="FromLabel" Text="From" VerticalAlignment="Center" />
          <TextBox Text="{Binding CustomFrom}" Width="220" Watermark="2026-11-21T10:00:00Z" AutomationProperties.LabeledBy="{Binding #FromLabel}" />
          <TextBlock Name="ToLabel" Text="To" VerticalAlignment="Center" />
          <TextBox Text="{Binding CustomTo}" Width="220" Watermark="2026-11-21T12:00:00Z" AutomationProperties.LabeledBy="{Binding #ToLabel}" />
        </StackPanel>
        <Button Content="Load history" Command="{Binding LoadCommand}" IsDefault="True" />
        <Button Content="Reload catalog" Command="{Binding RefreshCommand}" />
      </StackPanel>
      <TextBlock Text="{Binding ErrorMessage}" Foreground="Firebrick" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
      <ctl:LineChart Series="{Binding Chart}" Height="220" AutomationProperties.Name="History line chart" AutomationProperties.HelpText="{Binding ChartNote}" />
      <TextBlock Text="{Binding ChartNote}" TextWrapping="Wrap" />
    </StackPanel>
    <DataGrid ItemsSource="{Binding Rows}" IsReadOnly="True" AutoGenerateColumns="False" AutomationProperties.Name="History readings">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" />
        <DataGridTextColumn Header="Signal" Binding="{Binding Signal}" />
        <DataGridTextColumn Header="Value" Binding="{Binding Value}" />
        <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" />
        <DataGridTextColumn Header="Freshness" Binding="{Binding Freshness}" />
        <DataGridTextColumn Header="Quality" Binding="{Binding Quality}" />
        <DataGridTextColumn Header="Observed" Binding="{Binding ObservedAt}" />
        <DataGridTextColumn Header="Age" Binding="{Binding Age}" />
        <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
