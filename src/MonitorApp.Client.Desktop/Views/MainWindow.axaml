<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MonitorApp.Client.Core.ViewModels"
        x:Class="MonitorApp.Client.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Monitor App" Width="1100" Height="760" MinWidth="640" MinHeight="480">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowsAddress}">
        <TextBlock Name="AddressLabel" Text="Node address" VerticalAlignment="Center" />
        <TextBox Name="AddressBox" Width="360" Text="{Binding AddressText}"
                 AutomationProperties.LabeledBy="{Binding #AddressLabel}" />
        <Button Content="Connect" Command="{Binding ConnectCommand}" IsDefault="True"
                AutomationProperties.Name="Connect to node address" />
      </StackPanel>
      <TextBlock Text="{Binding AddressError}" Foreground="Firebrick" IsVisible="{Binding AddressError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Text="{Binding ConnectionStatus}" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
    </StackPanel>
    <TabControl ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}">
      <TabControl.ItemTemplate>
        <DataTemplate x:DataType="vm:SectionViewModel"><TextBlock Text="{Binding Title}" /></DataTemplate>
      </TabControl.ItemTemplate>
    </TabControl>
  </DockPanel>
</Window>
