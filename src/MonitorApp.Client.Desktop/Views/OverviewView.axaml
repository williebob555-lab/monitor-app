<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MonitorApp.Client.Core.ViewModels"
             x:Class="MonitorApp.Client.Desktop.Views.OverviewView" x:DataType="vm:OverviewViewModel">
  <ScrollViewer><StackPanel Spacing="8" Margin="8">
    <Button Content="Refresh" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" />
    <TextBlock Text="{Binding ErrorMessage}" Foreground="Firebrick" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
    <TextBlock Text="Runtime" FontWeight="SemiBold" />
    <TextBlock Text="{Binding RuntimeStatus, StringFormat='Status: {0}'}" />
    <TextBlock Text="{Binding Scope}" TextWrapping="Wrap" />
    <TextBlock Text="Local peer" FontWeight="SemiBold" />
    <TextBlock Text="{Binding LocalPeerId, StringFormat='Peer id: {0}'}" />
    <TextBlock Text="{Binding LocalFingerprint, StringFormat='SHA-256 fingerprint: {0}'}" TextWrapping="Wrap" />
    <TextBlock Text="{Binding PendingPairingCount, StringFormat='Pairings awaiting a decision or completion: {0}'}" />
    <TextBlock Text="Trusted and revoked peers" FontWeight="SemiBold" />
    <DataGrid ItemsSource="{Binding Peers}" IsReadOnly="True" AutoGenerateColumns="False" MinHeight="120"
              AutomationProperties.Name="Trusted and revoked peers">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Peer" Binding="{Binding Name}" />
        <DataGridTextColumn Header="Trust" Binding="{Binding TrustState}" />
        <DataGridTextColumn Header="Fingerprint" Binding="{Binding Fingerprint}" />
        <DataGridTextColumn Header="Paired" Binding="{Binding PairedAt}" />
        <DataGridTextColumn Header="Revoked" Binding="{Binding RevokedAt}" />
      </DataGrid.Columns>
    </DataGrid>
  </StackPanel></ScrollViewer>
</UserControl>
