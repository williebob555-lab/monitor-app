<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Core.Api" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\contracts\monitor\v1\common.proto"
              ProtoRoot="..\..\contracts"
              GrpcServices="None" />
    <Protobuf Include="..\..\contracts\monitor\v1\telemetry.proto"
              ProtoRoot="..\..\contracts"
              GrpcServices="None" />
    <Protobuf Include="..\..\contracts\monitor\v1\enrollment.proto"
              ProtoRoot="..\..\contracts"
              GrpcServices="Both" />
    <Protobuf Include="..\..\contracts\monitor\v1\agent.proto"
              ProtoRoot="..\..\contracts"
              GrpcServices="Both" />
    <Protobuf Include="..\..\contracts\monitor\v1\peer.proto"
              ProtoRoot="..\..\contracts"
              GrpcServices="Both" />
  </ItemGroup>

</Project>
