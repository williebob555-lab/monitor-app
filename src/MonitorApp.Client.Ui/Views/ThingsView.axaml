<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MonitorApp.Client.Core.ViewModels"
             xmlns:core="using:MonitorApp.Client.Core"
             xmlns:views="using:MonitorApp.Client.Ui.Views"
             xmlns:ctl="using:MonitorApp.Client.Ui.Controls"
             x:Class="MonitorApp.Client.Ui.Views.ThingsView" x:DataType="vm:ThingsViewModel">
  <!--
    Things (bill of work items 5 to 7): every object in the shared model as a card. Each value carries a badge that says how it is known
    (measured, spec, entered, estimated, unknown), in words and colour. Parts sit inside their card. "Add" takes a few words.
    "Open" pulls a thing apart into its parts (ExplodedPanel), each with its own live readings.
  -->
  <UserControl.Styles>
    <StyleInclude Source="avares://MonitorApp.Client.Ui/Views/DiveStyles.axaml" />
    <Style Selector="StackPanel.page">
      <Setter Property="MaxWidth" Value="1200" />
    </Style>
    <Style Selector="Border.tile">
      <Setter Property="Padding" Value="16,14" />
    </Style>
    <Style Selector="Border.body">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.LineStrong}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Background" Value="{DynamicResource Brush.Surface2}" />
    </Style>
    <Style Selector="Expander.group">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0,4,0,0" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Expander.group /template/ ToggleButton#ExpanderHeader">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0,4" />
      <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="Expander.group /template/ Border#ExpanderContent">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0,2,0,0" />
    </Style>
    <Style Selector="TextBlock.badgetext">
      <Setter Property="FontSize" Value="{DynamicResource Size.Caption}" />
    </Style>
    <Style Selector="Path.kind">
      <Setter Property="Stroke" Value="{DynamicResource Brush.Transfer}" />
      <Setter Property="StrokeThickness" Value="1.5" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <!-- One value with its evidence badge; shared by cards, parts and the opened view. -->
    <DataTemplate DataType="vm:ThingValueRow">
      <Grid ColumnDefinitions="*,Auto" Margin="0,2">
        <StackPanel Spacing="0">
          <TextBlock Text="{Binding Label}" Classes="meta" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Column="1" Classes="badge" Margin="8,0,0,0" VerticalAlignment="Top"
                BorderBrush="{Binding BadgeBrushKey, Converter={x:Static ctl:ShellIcons.BrushByKey}}"
                ToolTip.Tip="{Binding SourceText, StringFormat='From {0}'}">
          <TextBlock Text="{Binding Badge}" Classes="badgetext"
                     Foreground="{Binding BadgeBrushKey, Converter={x:Static ctl:ShellIcons.BrushByKey}}" />
        </Border>
      </Grid>
    </DataTemplate>
    <!-- A heading of values ("NETWORK · 7"); big groups on a busy computer start folded so the card stays short. -->
    <DataTemplate DataType="vm:ThingValueGroup">
      <Expander Classes="group" IsExpanded="{Binding StartsOpen, Mode=OneTime}" HorizontalAlignment="Stretch" Margin="0,2"
                AutomationProperties.Name="{Binding Header}">
        <Expander.Header>
          <TextBlock Text="{Binding Header}" Classes="section" />
        </Expander.Header>
        <ItemsControl ItemsSource="{Binding Values}" />
      </Expander>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Panel>
    <!-- The card grid. -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsGrid}">
      <StackPanel Classes="page" Spacing="12" Margin="16">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4">
            <TextBlock Text="THINGS" Classes="section" />
            <TextBlock Text="Everything you own, use or plan" Classes="headline" TextWrapping="Wrap" />
            <TextBlock Text="Each value says how it is known: measured by monitoring, from a spec, entered by you, estimated, or unknown. Open a computer to see its parts."
                       Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="1" Classes="action" Content="Refresh" Command="{Binding ReloadCommand}" VerticalAlignment="Top"
                  AutomationProperties.Name="Refresh things" />
        </Grid>

        <!-- Network discovery (owner decision 2026-11-24): one switch per computer, off until turned on, own home network only. -->
        <Border Classes="tile" IsVisible="{Binding Discovery.IsAvailable}">
          <StackPanel Spacing="6" DataContext="{Binding Discovery}" x:DataType="vm:NetworkDiscoveryViewModel">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="2">
                <TextBlock Text="FIND DEVICES ON THIS NETWORK" Classes="section" />
                <TextBlock Text="{Binding Headline}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button Classes="action" Content="Turn on" Command="{Binding TurnOnCommand}" IsVisible="{Binding !IsOn}" IsEnabled="{Binding CanTurnOn}"
                        AutomationProperties.Name="Turn on finding devices on this network" />
                <Button Classes="action" Content="Turn off" Command="{Binding TurnOffCommand}" IsVisible="{Binding IsOn}" IsEnabled="{Binding CanTurnOff}"
                        AutomationProperties.Name="Turn off finding devices on this network" />
              </StackPanel>
            </Grid>
            <TextBlock Text="{Binding Message}" IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{Binding Explanation}" Classes="muted" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- Looking back in time: what the model held then; adding and editing are off. -->
        <Border Classes="tile" IsVisible="{Binding IsHistorical}" BorderBrush="{DynamicResource Brush.Warning}">
          <TextBlock Text="{Binding RecordedText}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap"
                     AutomationProperties.LiveSetting="Polite" />
        </Border>

        <!-- Quick capture: a name, or a name and a note on the next lines. -->
        <Border Classes="tile" IsVisible="{Binding CanChange}">
          <StackPanel Spacing="8">
            <TextBlock Text="ADD A THING" Classes="section" />
            <TextBox Text="{Binding NewThingText}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" MaxHeight="160"
                     Watermark="A model name or a product link, like &quot;Boss DS-1&quot;. The app guesses the kind and maker. Put a note on the next line if you like."
                     AutomationProperties.Name="New thing: name, then an optional note on the next lines" />
            <WrapPanel>
              <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding NewThingKind}" MinWidth="200" Margin="0,0,8,0"
                        AutomationProperties.Name="Kind of thing">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="core:ThingKindDto"><TextBlock Text="{Binding Label}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Classes="action" Content="Add" Command="{Binding AddCommand}" AutomationProperties.Name="Add this thing" />
            </WrapPanel>
            <TextBlock Text="{Binding AddError}" Classes="error" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"
                       IsVisible="{Binding AddError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Text="{Binding StatusMessage}" Classes="meta" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                       IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Border>

        <!-- What the things on record still need, worked out from their ports, connections and values (T069). -->
        <Expander IsVisible="{Binding HasMissing}" IsExpanded="True" HorizontalAlignment="Stretch" AutomationProperties.Name="What's missing">
          <Expander.Header>
            <TextBlock Text="{Binding MissingTitle}" Classes="section" />
          </Expander.Header>
          <ItemsControl ItemsSource="{Binding Missing}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ThingMissingRow">
                <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Need}" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.Fault}" IsVisible="{Binding IsProblem}" />
                    <TextBlock Text="{Binding Need}" FontWeight="SemiBold" TextWrapping="Wrap" IsVisible="{Binding !IsProblem}" />
                    <TextBlock Text="{Binding Explanation}" Classes="meta" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1" Classes="flat" Content="Add to my list" VerticalAlignment="Top" Margin="8,0,0,0"
                          IsVisible="{Binding $parent[views:ThingsView].((vm:ThingsViewModel)DataContext).CanChange}"
                          Command="{Binding $parent[views:ThingsView].((vm:ThingsViewModel)DataContext).AddNeedCommand}" CommandParameter="{Binding}"
                          AutomationProperties.Name="{Binding Need, StringFormat='Add {0} to my list'}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Expander>

        <Grid ColumnDefinitions="*,Auto">
          <TextBox Text="{Binding FilterText}" Watermark="Filter by name, kind or value" AutomationProperties.Name="Filter things" />
          <TextBlock Grid.Column="1" Text="{Binding CountText}" Classes="meta" VerticalAlignment="Center" Margin="12,0,0,0" />
        </Grid>
        <TextBlock Text="{Binding ErrorMessage}" Classes="error" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Text="{Binding EmptyText}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !HasCards}" />

        <ItemsControl ItemsSource="{Binding Cards}" AutomationProperties.Name="Things">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><ctl:DiveTileGrid MaxColumns="3" MinColumnWidth="300" Gap="12" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ThingCard">
              <Border Classes="tile" AutomationProperties.Name="{Binding Name}">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="Auto,*">
                    <Path Classes="kind" Width="26" Height="26" Margin="0,2,10,0" VerticalAlignment="Top"
                          Data="{Binding KindId, Converter={x:Static ctl:ShellIcons.KindIcon}}" />
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Text="{Binding Name}" Classes="tiletitle" TextWrapping="Wrap" TextTrimming="None" />
                      <TextBlock Text="{Binding Subtitle}" Classes="meta" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding TagsText}" Classes="meta" Foreground="{DynamicResource Brush.Planned}" TextWrapping="Wrap" IsVisible="{Binding HasTags}" />
                    </StackPanel>
                  </Grid>

                  <ItemsControl ItemsSource="{Binding LinkTexts}" IsVisible="{Binding HasLinks}" AutomationProperties.Name="Links">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{Binding}" Classes="meta" Foreground="{DynamicResource Brush.Transfer}" TextWrapping="Wrap" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <StackPanel Spacing="2" IsVisible="{Binding HasPorts}" AutomationProperties.Name="Ports">
                    <TextBlock Text="Ports" Classes="section" />
                    <ItemsControl ItemsSource="{Binding PortTexts}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <TextBlock Text="{Binding}" Classes="meta" TextWrapping="Wrap" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <!-- Each connection path at this thing, followed through cables and adapters, with the engine's verdict and why. -->
                  <ItemsControl ItemsSource="{Binding WiringRows}" IsVisible="{Binding HasWiring}" AutomationProperties.Name="Connections">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ThingWiringRow">
                        <Border Classes="panelbox" Padding="8,6" Margin="0,2">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Route}" Classes="meta" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding VerdictText}" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.Healthy}" IsVisible="{Binding IsOk}" />
                            <TextBlock Text="{Binding VerdictText}" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.Fault}" IsVisible="{Binding IsProblem}" />
                            <TextBlock Text="{Binding VerdictText}" FontWeight="SemiBold" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.Warning}" IsVisible="{Binding IsUnknown}" />
                            <ItemsControl ItemsSource="{Binding Reasons}" IsVisible="{Binding HasReasons}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                  <TextBlock Text="{Binding}" Classes="meta" TextWrapping="Wrap" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <!-- A project's parts list: what is in hand, ordered and still to buy, and what the rest costs. -->
                  <StackPanel Spacing="4" IsVisible="{Binding HasProject}" AutomationProperties.Name="Parts list">
                    <TextBlock Text="Parts list" Classes="section" />
                    <TextBlock Text="{Binding Project.Summary}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Project.CostText}" TextWrapping="Wrap" IsVisible="{Binding Project.HasCost}" />
                    <ItemsControl ItemsSource="{Binding Project.Rows}" IsVisible="{Binding Project.HasRows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ThingProjectRow">
                          <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                            <StackPanel Spacing="0">
                              <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding PriceText}" Classes="meta" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding StateText}" Classes="meta" FontWeight="SemiBold" VerticalAlignment="Top" Margin="8,0,0,0"
                                       Foreground="{DynamicResource Brush.Warning}" IsVisible="{Binding IsToBuy}" />
                            <TextBlock Grid.Column="1" Text="{Binding StateText}" Classes="meta" FontWeight="SemiBold" VerticalAlignment="Top" Margin="8,0,0,0"
                                       Foreground="{DynamicResource Brush.Transfer}" IsVisible="{Binding IsOrdered}" />
                            <TextBlock Grid.Column="1" Text="{Binding StateText}" Classes="meta" FontWeight="SemiBold" VerticalAlignment="Top" Margin="8,0,0,0"
                                       Foreground="{DynamicResource Brush.Healthy}" IsVisible="{Binding IsHave}" />
                            <TextBlock Grid.Column="1" Text="{Binding StateText}" Classes="muted" VerticalAlignment="Top" Margin="8,0,0,0"
                                       IsVisible="{Binding IsGone}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <ItemsControl ItemsSource="{Binding Groups}" Classes="groups" IsVisible="{Binding HasValues}" />
                  <TextBlock Text="Nothing known about this yet." Classes="muted" IsVisible="{Binding !HasValues}" />

                  <!-- A rack drawn as it stands: rails, unit numbers from the top, each piece of equipment as a faceplate. -->
                  <StackPanel Spacing="4" IsVisible="{Binding HasRack}" AutomationProperties.Name="Rack">
                    <TextBlock Text="{Binding Rack.SizeText}" Classes="section" />
                    <Border Background="{DynamicResource Brush.Ink}" BorderBrush="{DynamicResource Brush.LineStrong}" BorderThickness="1"
                            CornerRadius="4" Padding="4">
                      <ItemsControl ItemsSource="{Binding Rack.Rows}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:ThingRackRow">
                            <Grid ColumnDefinitions="56,8,*,8" Height="{Binding Height}" Background="Transparent"
                                  PointerPressed="OnPlacePressed" PointerMoved="OnPlaceMoved" PointerReleased="OnPlaceReleased">
                              <TextBlock Text="{Binding UnitText}" Classes="meta" VerticalAlignment="Center" Margin="2,0,4,0" />
                              <Border Grid.Column="1" Background="{DynamicResource Brush.Surface3}" />
                              <Border Grid.Column="3" Background="{DynamicResource Brush.Surface3}" />
                              <Border Grid.Column="2" IsVisible="{Binding IsEmpty}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" />
                              <Border Grid.Column="2" IsVisible="{Binding IsOk}" Margin="0,1" CornerRadius="2"
                                      Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.LineStrong}" BorderThickness="1">
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" />
                              </Border>
                              <Border Grid.Column="2" IsVisible="{Binding IsProblem}" Margin="0,1" CornerRadius="2"
                                      Background="{DynamicResource Brush.Surface2}" BorderBrush="{DynamicResource Brush.Fault}" BorderThickness="2">
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Fault}" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis" />
                              </Border>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Rack.Notes}" IsVisible="{Binding Rack.HasNotes}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <TextBlock Text="{Binding}" Classes="meta" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <!-- A pedalboard or desk from above, drawn to scale in mm and fitted to the card; the front edge is at the bottom. -->
                  <StackPanel Spacing="4" IsVisible="{Binding HasBoard}" AutomationProperties.Name="Board">
                    <TextBlock Text="{Binding Board.SizeText}" Classes="section" TextWrapping="Wrap" />
                    <Viewbox Stretch="Uniform" MaxHeight="260" HorizontalAlignment="Left">
                      <Border Width="{Binding Board.Width}" Height="{Binding Board.Depth}" ClipToBounds="False"
                              Background="{DynamicResource Brush.Surface1}" BorderBrush="{DynamicResource Brush.LineStrong}" BorderThickness="3" CornerRadius="6">
                        <ItemsControl ItemsSource="{Binding Board.Items}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><Canvas /></ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.Styles>
                            <Style Selector="ContentPresenter" x:DataType="vm:ThingBoardItem">
                              <Setter Property="Canvas.Left" Value="{Binding Left}" />
                              <Setter Property="Canvas.Top" Value="{Binding Top}" />
                            </Style>
                          </ItemsControl.Styles>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ThingBoardItem">
                              <Grid Width="{Binding Width}" Height="{Binding Height}" Background="Transparent" Cursor="SizeAll"
                                    PointerPressed="OnPlacePressed" PointerMoved="OnPlaceMoved" PointerReleased="OnPlaceReleased"
                                    ToolTip.Tip="Drag to move">
                                <Border IsVisible="{Binding IsOk}" CornerRadius="4" Background="{DynamicResource Brush.Surface3}"
                                        BorderBrush="{DynamicResource Brush.LineStrong}" BorderThickness="2" />
                                <Border IsVisible="{Binding IsProblem}" CornerRadius="4" Background="{DynamicResource Brush.Surface3}"
                                        BorderBrush="{DynamicResource Brush.Fault}" BorderThickness="4" />
                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="4"
                                           FontSize="{Binding $parent[ItemsControl].((vm:ThingCard)DataContext).Board.LabelSize, FallbackValue=20}" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Border>
                    </Viewbox>
                    <ItemsControl ItemsSource="{Binding Board.Notes}" IsVisible="{Binding Board.HasNotes}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <TextBlock Text="{Binding}" Classes="meta" TextWrapping="Wrap" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>

                  <StackPanel Spacing="4" IsVisible="{Binding HasParts}">
                    <TextBlock Text="{Binding PartsHeading}" Classes="section" />
                    <ItemsControl ItemsSource="{Binding Parts}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ThingPartRow">
                          <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                            <Path Classes="kind" Width="16" Height="16" Margin="0,2,8,0" VerticalAlignment="Top"
                                  Data="{Binding KindId, Converter={x:Static ctl:ShellIcons.KindIcon}}" />
                            <StackPanel Grid.Column="1">
                              <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding Detail}" Classes="meta" TextWrapping="Wrap"
                                         IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                  <WrapPanel>
                    <Button Classes="action" Content="Open it up" Margin="0,4,8,0" IsVisible="{Binding CanOpen}"
                            Command="{Binding $parent[views:ThingsView].((vm:ThingsViewModel)DataContext).OpenCommand}"
                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding OpenLabel}" />
                    <Button Classes="action" Content="See it live" Margin="0,4,8,0" IsVisible="{Binding CanSeeLive}"
                            Command="{Binding $parent[views:ThingsView].((vm:ThingsViewModel)DataContext).SeeLiveCommand}"
                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat='See {0} live in the Ecosystem'}" />
                    <Button Classes="flat" Content="Edit" IsVisible="{Binding $parent[views:ThingsView].((vm:ThingsViewModel)DataContext).CanChange}" Margin="0,4,0,0"
                            Command="{Binding $parent[views:ThingsView].((vm:ThingsViewModel)DataContext).EditCommand}"
                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat='Edit {0}'}" />
                  </WrapPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- Open the machine: the thing in the middle, its parts pulled out around it, each with its own readings. -->
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsOpen}">
      <StackPanel Classes="page" Spacing="12" Margin="16">
        <Grid ColumnDefinitions="*,Auto">
          <Button Classes="action" Content="Back to things" Command="{Binding CloseCommand}" HorizontalAlignment="Left"
                  AutomationProperties.Name="Back to all things" />
          <Button Grid.Column="1" Classes="action" Content="Refresh" Command="{Binding ReloadCommand}"
                  AutomationProperties.Name="Refresh readings" />
        </Grid>
        <StackPanel Spacing="2">
          <TextBlock Text="OPENED UP" Classes="section" />
          <TextBlock Text="{Binding RecordedText}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" IsVisible="{Binding IsHistorical}" />
          <TextBlock Text="{Binding OpenCard.Name, FallbackValue=''}" Classes="headline" TextWrapping="Wrap" />
          <TextBlock Text="Its parts and whatever you put inside it, each with what is known about it."
                     Classes="muted" TextWrapping="Wrap" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding OpenItems}" AutomationProperties.Name="Parts">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><ctl:ExplodedPanel Gap="14" LineBrush="{DynamicResource Brush.Transfer}" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.DataTemplates>
            <DataTemplate DataType="vm:ThingCard">
              <Border Classes="tile body" AutomationProperties.Name="{Binding Name}">
                <StackPanel Spacing="10">
                  <Path Classes="kind" Width="56" Height="56" HorizontalAlignment="Center"
                        Data="{Binding KindId, Converter={x:Static ctl:ShellIcons.KindIcon}}" />
                  <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Name}" Classes="tiletitle" TextWrapping="Wrap" TextTrimming="None" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock Text="{Binding Subtitle}" Classes="meta" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                  </StackPanel>
                  <ItemsControl ItemsSource="{Binding Groups}" Classes="groups" IsVisible="{Binding HasValues}" />
                  <Button Classes="flat" Content="Edit" IsVisible="{Binding $parent[views:ThingsView].((vm:ThingsViewModel)DataContext).CanChange}" HorizontalAlignment="Center"
                          Command="{Binding $parent[views:ThingsView].((vm:ThingsViewModel)DataContext).EditCommand}"
                          CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat='Edit {0}'}" />
                </StackPanel>
              </Border>
            </DataTemplate>
            <DataTemplate DataType="vm:ThingPartRow">
              <Border Classes="tile" AutomationProperties.Name="{Binding Name}">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="Auto,*">
                    <Path Classes="kind" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center"
                          Data="{Binding KindId, Converter={x:Static ctl:ShellIcons.KindIcon}}" />
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding KindText}" Classes="meta"
                                 IsVisible="{Binding KindText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Values}" IsVisible="{Binding HasValues}" />
 <TextBlock Text="Nothing known about this yet." Classes="muted" IsVisible="{Binding !HasValues}" />
                  <WrapPanel>
                    <Button Classes="flat" Content="See it live" Margin="0,0,8,0" IsVisible="{Binding CanSeeLive}"
                            Command="{Binding $parent[views:ThingsView].((vm:ThingsViewModel)DataContext).SeeLiveCommand}"
                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat='See {0} live in the Ecosystem'}" />
                    <Button Classes="flat" Content="Edit" IsVisible="{Binding $parent[views:ThingsView].((vm:ThingsViewModel)DataContext).CanChange}"
                            Command="{Binding $parent[views:ThingsView].((vm:ThingsViewModel)DataContext).EditCommand}"
                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Name, StringFormat='Edit {0}'}" />
                  </WrapPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.DataTemplates>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <!-- Edit a thing: name, kind, the person's own note, and what it sits inside. Readings are never edited here. -->
    <Border Background="#A0000000" IsVisible="{Binding IsEditing}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Center">
        <Border Classes="tile body" MaxWidth="520" Margin="16" AutomationProperties.Name="Edit thing">
          <StackPanel Spacing="10">
            <StackPanel Spacing="2">
              <TextBlock Text="EDIT" Classes="section" />
              <TextBlock Text="{Binding EditingName, FallbackValue=''}" Classes="headline" TextWrapping="Wrap" />
              <TextBlock Text="What you change here is marked as entered by you. Readings from monitoring stay as they are."
                         Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Text="Name" Classes="meta" />
            <TextBox Text="{Binding EditName}" AutomationProperties.Name="Name" />
            <TextBlock Text="Kind" Classes="meta" />
            <ComboBox ItemsSource="{Binding EditKinds}" SelectedItem="{Binding EditKind}" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="Kind of thing">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="core:ThingKindDto"><TextBlock Text="{Binding Label}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="Inside" Classes="meta" />
            <ComboBox ItemsSource="{Binding EditPlaces}" SelectedItem="{Binding EditInside}" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="What it sits inside">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ThingPlace"><TextBlock Text="{Binding Name}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="Where inside: in a rack the bottom unit, like U5; on a board or desk x, y in mm from the front-left corner, like 120, 40" Classes="meta" TextWrapping="Wrap" IsVisible="{Binding EditInside.Id, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}" />
            <TextBox Text="{Binding EditSlot}" Watermark="U5 or 120, 40" MaxLength="16" AutomationProperties.Name="Where inside"
                     IsVisible="{Binding EditInside.Id, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}" />
            <TextBlock Text="Stage" Classes="meta" />
            <ComboBox ItemsSource="{Binding Stages}" SelectedItem="{Binding EditStage}" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="Where it is in its life">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:ThingStage"><TextBlock Text="{Binding Text}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="Tags" Classes="meta" />
            <TextBox Text="{Binding EditTags}" Watermark="studio, spare, needs repair" AutomationProperties.Name="Tags, separated by commas" />
            <TextBlock Text="Note" Classes="meta" />
            <TextBox Text="{Binding EditNote}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="200"
                     Watermark="Anything worth remembering" AutomationProperties.Name="Note" />
            <TextBlock Text="Links" Classes="meta" />
            <ItemsControl ItemsSource="{Binding EditLinks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="core:ThingLinkDto">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                      <Run Text="{Binding Phrase}" /><Run Text=" " /><Run Text="{Binding OtherName}" FontWeight="SemiBold" />
                    </TextBlock>
                    <Button Grid.Column="1" Classes="flat" Content="Remove"
                            Command="{Binding $parent[views:ThingsView].((vm:ThingsViewModel)DataContext).RemoveLinkCommand}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding OtherName, StringFormat='Remove the link to {0}'}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnDefinitions="Auto,8,*">
              <ComboBox ItemsSource="{Binding LinkTypes}" SelectedItem="{Binding NewLinkType}" MinWidth="140" AutomationProperties.Name="Kind of link">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="core:ThingKindDto"><TextBlock Text="{Binding Label}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <ComboBox Grid.Column="2" ItemsSource="{Binding LinkTargets}" SelectedItem="{Binding NewLinkTarget}" HorizontalAlignment="Stretch"
                        PlaceholderText="Pick a thing to link to" AutomationProperties.Name="Thing to link to">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ThingPlace"><TextBlock Text="{Binding Name}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
            <TextBlock Text="Ports" Classes="meta" />
            <ItemsControl ItemsSource="{Binding EditPorts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="core:ThingPortDto">
                  <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                      <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="{Binding OtherName, Mode=OneWay, StringFormat=' → {0}'}" /><Run Text="{Binding OtherPortName, Mode=OneWay, StringFormat=' {0}'}" />
                    </TextBlock>
                    <Button Grid.Column="1" Classes="flat" Content="Unplug" IsVisible="{Binding ConnectionId, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Command="{Binding $parent[views:ThingsView].((vm:ThingsViewModel)DataContext).UnplugPortCommand}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Name, StringFormat='Unplug {0}'}" />
                    <Button Grid.Column="2" Classes="flat" Content="Remove"
                            Command="{Binding $parent[views:ThingsView].((vm:ThingsViewModel)DataContext).RemovePortCommand}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Name, StringFormat='Remove the port {0}'}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Add a port" Classes="meta" />
            <TextBox Name="NewPortName" Text="{Binding NewPortName}" Watermark="Name, like DC in or Line out L" AutomationProperties.Name="Name of the new port" />
            <ComboBox ItemsSource="{Binding Connectors}" SelectedItem="{Binding NewPortConnector}" HorizontalAlignment="Stretch"
                      PlaceholderText="Connector" AutomationProperties.Name="Connector of the new port">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="core:ConnectorChoiceDto"><TextBlock Text="{Binding Label}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Grid ColumnDefinitions="*,8,*">
              <ComboBox ItemsSource="{Binding Genders}" SelectedItem="{Binding NewPortGender}" HorizontalAlignment="Stretch"
                        PlaceholderText="Plug or socket" AutomationProperties.Name="Plug or socket" />
              <ComboBox Grid.Column="2" ItemsSource="{Binding Directions}" SelectedItem="{Binding NewPortDirection}" HorizontalAlignment="Stretch"
                        PlaceholderText="Output or input" AutomationProperties.Name="Which way it goes" />
            </Grid>
            <TextBox Text="{Binding NewPortSignals}" Watermark="What it carries, like usb-3, dp-alt or analog-audio" AutomationProperties.Name="What the port carries" />
            <Grid ColumnDefinitions="*,8,*">
              <TextBox Text="{Binding NewPortVoltage}" Watermark="Voltage, like 9 V" AutomationProperties.Name="Voltage" />
              <TextBox Grid.Column="2" Text="{Binding NewPortPolarity}" Watermark="Polarity, like center-negative" AutomationProperties.Name="Polarity" />
            </Grid>
            <Grid ColumnDefinitions="*,8,*">
              <TextBox Text="{Binding NewPortCurrent}" Watermark="Current, like 500 mA" AutomationProperties.Name="Current it supplies or draws" />
              <TextBox Grid.Column="2" Text="{Binding NewPortLevel}" Watermark="Level, like line or instrument" AutomationProperties.Name="Signal level" />
            </Grid>
            <CheckBox IsChecked="{Binding NewPortFromSpec}" Content="These port values come from a spec sheet" />
            <TextBlock Text="Plug in" Classes="meta" />
            <Grid ColumnDefinitions="*,8,*">
              <ComboBox ItemsSource="{Binding ConnectFromChoices}" SelectedItem="{Binding ConnectFrom}" HorizontalAlignment="Stretch"
                        PlaceholderText="This thing's port" AutomationProperties.Name="Port to plug in">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ThingPortChoice"><TextBlock Text="{Binding Text}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <ComboBox Grid.Column="2" ItemsSource="{Binding ConnectToChoices}" SelectedItem="{Binding ConnectTo}" HorizontalAlignment="Stretch"
                        PlaceholderText="Into" AutomationProperties.Name="Port to plug it into">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ThingPortChoice"><TextBlock Text="{Binding Text}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
            <TextBlock Text="Add a value" Classes="meta" />
            <Grid ColumnDefinitions="*,8,*">
              <TextBox Text="{Binding NewValueLabel}" Watermark="Name, like Max power" AutomationProperties.Name="Name of the value" />
              <TextBox Grid.Column="2" Text="{Binding NewValueText}" Watermark="Value, like 5 W" AutomationProperties.Name="The value; leave empty to remove yours" />
            </Grid>
            <TextBlock Classes="meta" TextWrapping="Wrap"
                       Text="Price ($45), Quantity (2), Width and Depth (70 mm) and Rack units (2U) are understood: they feed parts lists, racks and boards." />
            <CheckBox IsChecked="{Binding NewValueFromSpec}" Content="I read this from a spec sheet or datasheet" />
            <TextBlock Text="{Binding EditError}" Classes="error" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive"
                       IsVisible="{Binding EditError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <WrapPanel>
              <Button Classes="action" Content="Save" Margin="0,0,8,0" Command="{Binding SaveEditCommand}" AutomationProperties.Name="Save changes" />
              <Button Classes="flat" Content="Cancel" Command="{Binding CancelEditCommand}" AutomationProperties.Name="Cancel editing" />
            </WrapPanel>
          </StackPanel>
        </Border>
      </ScrollViewer>
    </Border>
  </Panel>
</UserControl>
