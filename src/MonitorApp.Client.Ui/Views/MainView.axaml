<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MonitorApp.Client.Core.ViewModels"
             xmlns:views="using:MonitorApp.Client.Ui.Views"
             x:Class="MonitorApp.Client.Ui.Views.MainView"
             x:DataType="vm:MainViewModel">
  <UserControl.DataTemplates>
    <!-- One template per section view model. Adding a section means adding one entry here and one in MainViewModel. -->
    <DataTemplate DataType="vm:DevicesViewModel"><views:DevicesView /></DataTemplate>
    <DataTemplate DataType="vm:AlertsViewModel"><views:AlertsView /></DataTemplate>
    <DataTemplate DataType="vm:StateViewModel"><views:StateView /></DataTemplate>
    <DataTemplate DataType="vm:HistoryViewModel"><views:HistoryView /></DataTemplate>
    <DataTemplate DataType="vm:AsOfViewModel"><views:AsOfView /></DataTemplate>
    <DataTemplate DataType="vm:PairingsViewModel"><views:PairingsView /></DataTemplate>
    <DataTemplate DataType="vm:PairDeviceViewModel"><views:PairDeviceView /></DataTemplate>
    <DataTemplate DataType="vm:OverviewViewModel"><views:OverviewView /></DataTemplate>
  </UserControl.DataTemplates>

  <!-- Wide (tablet, desktop): navigation pane always open on the left. Compact (phone): pane is an overlay opened by the
       menu button, and the first sections are repeated in a bottom bar. The layout switch is in MainView.axaml.cs. -->
  <Grid RowDefinitions="Auto,*,Auto">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="8,8,8,0">
      <Button Name="MenuButton" Grid.Column="0" Content="Menu" Margin="0,0,8,0"
              AutomationProperties.Name="Open navigation menu" Click="OnMenuClick" />
      <TextBlock Grid.Column="1" Text="{Binding SelectedSection.Title}" Classes="heading" VerticalAlignment="Center"
                 AutomationProperties.LiveSetting="Polite" />
    </Grid>

    <SplitView Name="Split" Grid.Row="1" DisplayMode="Inline" IsPaneOpen="True" OpenPaneLength="240">
      <SplitView.Pane>
        <ListBox Name="NavList" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection, Mode=OneWay}"
                 AutomationProperties.Name="Sections" SelectionChanged="OnNavSelectionChanged" Tapped="OnNavTapped">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SectionViewModel"><TextBlock Text="{Binding Title}" VerticalAlignment="Center" /></DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </SplitView.Pane>
      <DockPanel Margin="0,4,0,0">
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="12,0,12,4">
          <WrapPanel IsVisible="{Binding ShowsAddress}">
            <StackPanel Classes="field">
              <TextBlock Name="AddressLabel" Text="Node address" Classes="label" />
              <TextBox Name="AddressBox" Text="{Binding AddressText}" MinWidth="280" AutomationProperties.LabeledBy="{Binding #AddressLabel}" />
            </StackPanel>
            <Button Content="Connect" Command="{Binding ConnectCommand}" IsDefault="True" VerticalAlignment="Bottom" Margin="0,0,0,8"
                    AutomationProperties.Name="Connect to node address" />
          </WrapPanel>
          <TextBlock Text="{Binding AddressError}" Classes="error" IsVisible="{Binding AddressError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="{Binding ConnectionStatus}" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" Classes="muted" />
        </StackPanel>
        <ContentControl Content="{Binding SelectedSection}" />
      </DockPanel>
    </SplitView>

    <Grid Name="BottomBar" Grid.Row="2" ColumnDefinitions="*,Auto" IsVisible="False">
      <ListBox Name="PrimaryList" Grid.Column="0" ItemsSource="{Binding PrimarySections}" SelectedItem="{Binding SelectedSection, Mode=OneWay}"
               AutomationProperties.Name="Main sections" SelectionChanged="OnNavSelectionChanged">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:SectionViewModel"><TextBlock Text="{Binding Title}" TextAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="13" /></DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Button Grid.Column="1" Content="More" Click="OnMenuClick" AutomationProperties.Name="More sections" />
    </Grid>
  </Grid>
</UserControl>
