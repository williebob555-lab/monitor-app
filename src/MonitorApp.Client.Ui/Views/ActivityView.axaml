<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MonitorApp.Client.Core.ViewModels"
             xmlns:act="using:MonitorApp.Client.Core.ViewModels.Activity"
             xmlns:dive="using:MonitorApp.Client.Core.ViewModels.Dive"
             xmlns:views="using:MonitorApp.Client.Ui.Views"
             xmlns:ctl="using:MonitorApp.Client.Ui.Controls"
             x:Class="MonitorApp.Client.Ui.Views.ActivityView" x:DataType="vm:ActivityViewModel">
  <!--
    History in the Dive's language: "What happened" (a day-grouped story of real events: alerts raised and resolved, pairings, trust
    changes), a page per event that shows the device as recorded at that moment, and "Browse history" with the older tools (each opens inside,
    with the shell's back chip on a phone). Card styles are shared with the Dive and Alerts (DiveStyles.axaml). One centred 960 px column wide;
    a single column with 44 px targets on a phone.
  -->
  <UserControl.Styles>
    <StyleInclude Source="avares://MonitorApp.Client.Ui/Views/DiveStyles.axaml" />
    <Style Selector="StackPanel.page">
      <Setter Property="MaxWidth" Value="960" />
    </Style>
    <Style Selector="Border.tile">
      <Setter Property="Padding" Value="16,12" />
    </Style>
    <Style Selector="Panel.narrow Border.tile">
      <Setter Property="Padding" Value="12,10" />
    </Style>
    <Style Selector="TextBlock.tiletitle">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="TextTrimming" Value="None" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.headline">
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.clock">
      <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
      <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <!-- Entry rows: the clock in its own column; on a phone it narrows. -->
    <Style Selector="TextBlock.clock">
      <Setter Property="Width" Value="64" />
    </Style>
    <Style Selector="Panel.narrow TextBlock.clock">
      <Setter Property="Width" Value="52" />
    </Style>
    <Style Selector="WrapPanel.gauges">
      <Setter Property="ItemWidth" Value="172" />
    </Style>
    <Style Selector="Panel.narrow WrapPanel.gauges">
      <Setter Property="ItemWidth" Value="148" />
    </Style>
    <Style Selector="StackPanel.browsehead">
      <Setter Property="Margin" Value="24,16,24,0" />
      <Setter Property="MaxWidth" Value="900" />
    </Style>
    <Style Selector="Panel.narrow StackPanel.browsehead">
      <Setter Property="Margin" Value="12,10,12,0" />
    </Style>
    <!-- Page buttons: side by side when wide, stacked full width on a phone. -->
    <Style Selector="StackPanel.pageactions">
      <Setter Property="Orientation" Value="Horizontal" />
    </Style>
    <Style Selector="Panel.narrow StackPanel.pageactions">
      <Setter Property="Orientation" Value="Vertical" />
    </Style>
    <Style Selector="Panel.narrow Button.cta">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Panel.narrow Button.action">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <UserControl.DataTemplates>
    <!-- Status: a shape and words in the same semantic colour, inside an outlined pill (as in the Dive). -->
    <DataTemplate DataType="dive:DiveBadge">
      <Border Classes="badge" BorderBrush="{Binding Converter={x:Static ctl:DiveConverters.BadgeBrush}}" ToolTip.Tip="{Binding Text}">
        <DockPanel>
          <Path DockPanel.Dock="Left" Classes="marker" Width="9" Height="9" Margin="0,0,6,0"
                Data="{Binding Converter={x:Static ctl:DiveConverters.BadgeShape}}"
                Fill="{Binding Converter={x:Static ctl:DiveConverters.BadgeBrush}}" />
          <TextBlock Text="{Binding Text}" FontSize="{DynamicResource Size.Small}" FontWeight="SemiBold" VerticalAlignment="Center"
                     Foreground="{Binding Converter={x:Static ctl:DiveConverters.BadgeBrush}}" TextTrimming="CharacterEllipsis" />
        </DockPanel>
      </Border>
    </DataTemplate>

    <!-- One entry of the story: clock, severity and kind, title, device. -->
    <DataTemplate DataType="act:ActivityEntry">
      <Button Classes="tile" Margin="0,0,0,8" Command="{Binding $parent[views:ActivityView].((vm:ActivityViewModel)DataContext).OpenCommand}"
              CommandParameter="{Binding}" AutomationProperties.Name="{Binding AccessibleText}">
        <Border Classes="tile" Classes.alarm="{Binding IsAlarm}">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <TextBlock Text="{Binding TimeText}" Classes="clock" VerticalAlignment="Top" />
            <StackPanel Grid.Column="1" Spacing="4">
              <WrapPanel>
                <ContentControl Content="{Binding Severity}" Margin="0,0,10,2" />
                <TextBlock Text="{Binding KindText}" Classes="meta" VerticalAlignment="Center" Margin="0,0,0,2" />
              </WrapPanel>
              <TextBlock Text="{Binding Title}" Classes="tiletitle" />
              <TextBlock Text="{Binding DeviceText}" Classes="muted" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="›" FontSize="22" Margin="12,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextSecondary}" AutomationProperties.AccessibilityView="Raw" />
          </Grid>
        </Border>
      </Button>
    </DataTemplate>

    <!-- Home: the story by day, then the older tools. -->
    <DataTemplate DataType="act:ActivityHomePage">
      <ScrollViewer Name="ActivityScroll" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Classes="page">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
              <TextBlock Text="WHAT HAPPENED" Classes="section" />
              <TextBlock Name="ActivityHeadline" Text="{Binding Headline}" Classes="headline" AutomationProperties.LiveSetting="Polite" />
              <TextBlock Name="ActivityBreakdown" Text="{Binding Breakdown}" Classes="muted" />
            </StackPanel>
            <Button Grid.Column="1" Classes="action" Content="Refresh" VerticalAlignment="Top" Margin="12,0,0,0"
                    Command="{Binding $parent[views:ActivityView].((vm:ActivityViewModel)DataContext).RefreshCommand}"
                    AutomationProperties.Name="Refresh what happened" />
          </Grid>
          <TextBlock Text="{Binding $parent[views:ActivityView].((vm:ActivityViewModel)DataContext).ErrorMessage}" Classes="error"
                     AutomationProperties.LiveSetting="Assertive"
                     IsVisible="{Binding $parent[views:ActivityView].((vm:ActivityViewModel)DataContext).ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <ItemsControl Name="ActivityDays" ItemsSource="{Binding Days}" AutomationProperties.Name="What happened, by day">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="act:ActivityDay">
                <StackPanel Spacing="8" Margin="0,0,0,12">
                  <TextBlock Text="{Binding Heading}" Classes="section" />
                  <ItemsControl ItemsSource="{Binding Items}" AutomationProperties.Name="{Binding Title}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Classes="panelbox" IsVisible="{Binding !HasDays}">
            <TextBlock Text="Nothing was recorded in this time: no alerts were raised or resolved and no devices were paired or revoked." Classes="muted" />
          </Border>

          <StackPanel Spacing="8" Margin="0,8,0,0">
            <TextBlock Text="BROWSE HISTORY" Classes="section" />
            <TextBlock Text="Look at the readings themselves: what each signal says now, over a range, or at a moment you choose." Classes="muted" />
            <ItemsControl Name="ActivityBrowse" ItemsSource="{Binding Browse}" AutomationProperties.Name="Browse history">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><ctl:DiveTileGrid MaxColumns="3" MinColumnWidth="240" Gap="12" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="act:ActivityBrowseTile">
                  <Button Classes="tile" Command="{Binding $parent[views:ActivityView].((vm:ActivityViewModel)DataContext).OpenToolCommand}"
                          CommandParameter="{Binding}" AutomationProperties.Name="{Binding AccessibleText}">
                    <Border Classes="tile">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                          <TextBlock Text="{Binding Title}" Classes="tiletitle" />
                          <TextBlock Text="{Binding Detail}" Classes="muted" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="›" FontSize="22" Margin="12,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextSecondary}" AutomationProperties.AccessibilityView="Raw" />
                      </Grid>
                    </Border>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>

    <!-- One event: what happened, the device as recorded then, the whole home then, and the way back to live. -->
    <DataTemplate DataType="act:ActivityEventPage">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Classes="page">
          <StackPanel Spacing="8">
            <TextBlock Name="EventTitle" Text="{Binding Title}" Classes="pagetitle" />
            <WrapPanel>
              <ContentControl Content="{Binding Severity}" Margin="0,0,10,4" />
              <TextBlock Text="{Binding KindText}" Classes="meta" VerticalAlignment="Center" Margin="0,0,0,4" />
            </WrapPanel>
            <TextBlock Name="EventWhen" Text="{Binding WhenText}" Classes="muted" />
          </StackPanel>

          <Border Classes="panelbox" Classes.critical="{Binding IsAlarm}" IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <StackPanel Spacing="8">
              <TextBlock Text="WHAT HAPPENED" Classes="section" />
              <TextBlock Name="EventDetail" Text="{Binding Detail}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Name="EventReadings" Classes="panelbox">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding ReadingsHeading}" Classes="section" />
              <WrapPanel>
                <TextBlock Name="EventDevice" Text="{Binding DeviceTitle}" Classes="tiletitle" VerticalAlignment="Center" Margin="0,0,12,4" />
                <ContentControl Content="{Binding DeviceBadge}" IsVisible="{Binding HasDeviceBadge}" Margin="0,0,0,4" />
              </WrapPanel>
              <TextBlock Text="{Binding DeviceMeta}" Classes="muted" IsVisible="{Binding DeviceMeta, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <TextBlock Name="EventReadingsNote" Text="{Binding ReadingsNote}" Classes="muted" IsVisible="{Binding HasReadingsNote}"
                         AutomationProperties.LiveSetting="Polite" />
              <ItemsControl Name="EventGauges" ItemsSource="{Binding Gauges}" IsVisible="{Binding HasGauges}" AutomationProperties.Name="Readings at that moment">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel Classes="gauges" HorizontalAlignment="Left" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="dive:DiveGauge">
                    <StackPanel Spacing="6" Margin="4,8" AutomationProperties.Name="{Binding AccessibleText}" ToolTip.Tip="{Binding Caption}">
                      <Panel Width="96" Height="96" HorizontalAlignment="Center">
                        <ctl:DiveRing Value="{Binding FillValue}" Thickness="9" Track="{DynamicResource Brush.Surface3}" IsVisible="{Binding HasFill}"
                                      Stroke="{Binding Level, Converter={x:Static ctl:DiveConverters.LevelBrush}}" />
                        <Ellipse Stroke="{DynamicResource Brush.Surface3}" StrokeThickness="9" IsVisible="{Binding !HasFill}" />
                        <StackPanel VerticalAlignment="Center" Margin="12,0">
                          <TextBlock Text="{Binding Value}" Classes="gaugevalue" FontSize="20" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasFill}" />
                          <TextBlock Text="{Binding Value}" Classes="gaugevalue" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                                     MaxLines="2" IsVisible="{Binding !HasFill}" />
                          <TextBlock Text="{Binding Unit}" Classes="gaugeunit" />
                        </StackPanel>
                      </Panel>
                      <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" />
                      <TextBlock Text="{Binding Caption}" Classes="meta" TextAlignment="Center" HorizontalAlignment="Center" MaxLines="2"
                                 TextTrimming="CharacterEllipsis" />
                      <StackPanel Spacing="2" IsVisible="{Binding HasTrend}" HorizontalAlignment="Center" ToolTip.Tip="{Binding Trend.Text, FallbackValue=''}">
                        <ctl:Sparkline Width="132" Height="28" Points="{Binding Trend.Points, FallbackValue={x:Null}}" StrokeThickness="1.5"
                                       Stroke="{Binding Trend.Kind, FallbackValue=Cpu, Converter={x:Static ctl:DiveConverters.TrendBrush}}" />
                        <TextBlock Text="{Binding $parent[ItemsControl].((act:ActivityEventPage)DataContext).MomentText, StringFormat='10 min before {0}', FallbackValue=''}"
                                   Classes="meta" HorizontalAlignment="Center" />
                      </StackPanel>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <StackPanel Classes="pageactions" Margin="0,6,0,0">
                <Button Name="SeeWholeHome" Classes="cta" Content="{Binding WholeHomeText, StringFormat='{}{0} ›'}" Margin="0,0,12,8"
                        Command="{Binding $parent[views:ActivityView].((vm:ActivityViewModel)DataContext).SeeWholeHomeCommand}"
                        AutomationProperties.Name="{Binding WholeHomeText}" />
                <Button Name="EventReturnLive" Classes="action" Content="Return to live" Margin="0,0,0,8"
                        IsVisible="{Binding $parent[views:ActivityView].((vm:ActivityViewModel)DataContext).IsHistorical}"
                        Command="{Binding $parent[views:ActivityView].((vm:ActivityViewModel)DataContext).ReturnToLiveCommand}" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="panelbox" IsVisible="{Binding HasNearby}">
            <StackPanel Spacing="8">
              <TextBlock Text="AROUND THEN · WITHIN AN HOUR" Classes="section" />
              <ItemsControl Name="EventNearby" ItemsSource="{Binding Nearby}" AutomationProperties.Name="Around then" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DataTemplate>

    <!-- An older history tool, shown inside History (its own view comes from the shell's templates). -->
    <DataTemplate DataType="act:ActivityBrowsePage">
      <Grid RowDefinitions="Auto,*">
        <StackPanel Classes="browsehead" Spacing="4">
          <TextBlock Text="BROWSE HISTORY" Classes="section" />
          <TextBlock Text="{Binding Detail}" Classes="muted" />
        </StackPanel>
        <ContentControl Name="BrowseHost" Grid.Row="1" Content="{Binding Section}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
      </Grid>
    </DataTemplate>
  </UserControl.DataTemplates>

  <Grid RowDefinitions="Auto,*">
    <!-- Recorded: the moment in words, and the way back. -->
    <Border Name="ActivityRecordedBand" IsVisible="{Binding IsHistorical}" BorderBrush="{DynamicResource Brush.Warning}" BorderThickness="0,0,0,1"
            Background="{DynamicResource Brush.Surface2}">
      <DockPanel Margin="16,0">
        <Button Name="ActivityBandLive" DockPanel.Dock="Right" Classes="flat" Content="Return to live" MinHeight="44"
                Command="{Binding ReturnToLiveCommand}" AutomationProperties.Name="Return to live" />
        <TextBlock Text="{Binding RecordedText}" FontFamily="{DynamicResource Font.Mono}" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Warning}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>
    <Panel Name="Stage" Grid.Row="1" ClipToBounds="True">
      <ContentControl Name="PageHost" Content="{Binding Page}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Panel>
  </Grid>
</UserControl>
