<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MonitorApp.Client.Core.ViewModels"
             x:Class="MonitorApp.Client.Ui.Views.AlertsView" x:DataType="vm:AlertsViewModel">
  <ScrollViewer><StackPanel Spacing="8" Margin="12" MaxWidth="900" HorizontalAlignment="Stretch">
    <TextBlock Text="Alerts" Classes="heading" />
    <WrapPanel>
      <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,12,0" />
      <TextBlock Text="{Binding UpdateMode, StringFormat='Updates: {0}'}" VerticalAlignment="Center" />
    </WrapPanel>
    <TextBlock Text="{Binding ErrorMessage}" Classes="error" AutomationProperties.LiveSetting="Assertive" />
    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    <ItemsControl ItemsSource="{Binding Alerts}" AutomationProperties.Name="Alerts">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:AlertRow">
          <Border Classes="card">
            <StackPanel Spacing="4">
              <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                <Run Text="[" /><Run Text="{Binding State}" /><Run Text=" / " /><Run Text="{Binding Severity}" /><Run Text="] " /><Run Text="{Binding Title}" />
              </TextBlock>
              <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Origin, StringFormat='Device: {0}'}" Classes="muted" FontSize="13" />
              <TextBlock Text="{Binding Subject, StringFormat='Subject: {0}'}" Classes="muted" FontSize="13" />
              <TextBlock Text="{Binding Raised, StringFormat='Raised: {0}'}" Classes="muted" FontSize="13" />
              <TextBlock Text="{Binding Resolved, StringFormat='Resolved: {0}'}" Classes="muted" FontSize="13" IsVisible="{Binding Resolved, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel></ScrollViewer>
</UserControl>
