<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MonitorApp.Client.Core.ViewModels.Shell"
             x:Name="Root"
             x:Class="MonitorApp.Client.Ui.Views.SearchPageView" x:DataType="vm:SearchViewModel">
  <!-- Full-page search: the Search mode, and the phone's search tab. Results jump to the object (and reading) in the workspace. -->
  <Grid RowDefinitions="Auto,Auto,*" Margin="12">
    <TextBox Name="SearchPageBox" Grid.Row="0" Text="{Binding Query}" Watermark="Search devices, services, layers and readings"
             AutomationProperties.Name="Search devices, services, layers and readings" />
    <TextBlock Grid.Row="1" Text="{Binding Status}" Classes="meta" Margin="2,8" AutomationProperties.LiveSetting="Polite" />
    <ScrollViewer Grid.Row="2">
      <ItemsControl ItemsSource="{Binding Results}" AutomationProperties.Name="Search results">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SearchResultRow">
            <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    Command="{Binding #Root.((vm:SearchViewModel)DataContext).JumpToCommand}" CommandParameter="{Binding}"
                    AutomationProperties.Name="{Binding AccessibleText}">
              <Grid ColumnDefinitions="72,*">
                <TextBlock Text="{Binding KindText}" Classes="section" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Text}" Classes="mono" TextWrapping="Wrap" VerticalAlignment="Center" />
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
