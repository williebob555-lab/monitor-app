<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MonitorApp.Client.Core.ViewModels"
             xmlns:ctl="using:MonitorApp.Client.Ui.Controls"
             x:Class="MonitorApp.Client.Ui.Views.PairDeviceView" x:DataType="vm:PairDeviceViewModel">
  <ScrollViewer><StackPanel Spacing="8" Margin="12" MaxWidth="900" HorizontalAlignment="Stretch">
    <TextBlock Text="Add a device" Classes="heading" />
    <TextBlock TextWrapping="Wrap"
               Text="One way for every device. Scan the code the other device shows: a computer's Pairing screen, or a phone's or tablet's &quot;Show my code&quot;. Or show this device's code and let the other one scan it. Once added, every one of your devices trusts it." />
    <TextBlock Text="{Binding ErrorMessage}" Classes="error" AutomationProperties.LiveSetting="Assertive" />
    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    <Border Classes="card">
      <StackPanel Spacing="8">
        <WrapPanel Orientation="Horizontal">
          <Button Name="ScanAnyCode" Classes="action" Content="Scan a code" Command="{Binding ScanQrCommand}" IsVisible="{Binding CanScanQr}" Margin="0,0,8,8" />
          <Button Name="ShowJoinCode" Content="Show my code" Command="{Binding ShowJoinCodeCommand}" IsVisible="{Binding CanAddMeshDevices}" Margin="0,0,8,8" />
        </WrapPanel>
        <Border Classes="card" IsVisible="{Binding HasPendingDevice}">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding PendingDevicePrompt}" TextWrapping="Wrap" FontWeight="SemiBold" />
            <WrapPanel Orientation="Horizontal">
              <Button Name="ConfirmDevice" Content="{Binding PendingDeviceAction}" Command="{Binding ConfirmPendingDeviceCommand}" Margin="0,0,8,0" />
              <Button Content="Cancel" Command="{Binding CancelPendingDeviceCommand}" />
            </WrapPanel>
          </StackPanel>
        </Border>
        <StackPanel Spacing="8" IsVisible="{Binding HasShownCode}">
          <ctl:QrCodeView Rows="{Binding ShownQrRows}" Width="300" Height="300" HorizontalAlignment="Left"
                          AutomationProperties.Name="Device code to scan" />
          <TextBlock Text="{Binding ShownCodeCaption}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding ThisDeviceCodeText}" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>
    </Border>
    <Expander Header="Other ways: type a computer's code or paste an invitation" HorizontalAlignment="Stretch">
    <StackPanel Spacing="8">
    <Border Classes="card">
      <StackPanel Spacing="8">
        <TextBlock Text="Type the code" Classes="subheading" />
        <StackPanel Classes="field" Margin="0">
          <TextBlock Name="AddressLabel" Text="Desktop address (host:port)" Classes="label" />
          <TextBox Text="{Binding AddressText}" Watermark="100.64.0.5:55433" AutomationProperties.LabeledBy="{Binding #AddressLabel}" />
        </StackPanel>
        <StackPanel Classes="field" Margin="0">
          <TextBlock Name="CodeLabel" Text="Pairing code" Classes="label" />
          <TextBox Text="{Binding CodeText}" AutomationProperties.LabeledBy="{Binding #CodeLabel}" />
        </StackPanel>
        <Button Content="Pair with code" Command="{Binding PairWithCodeCommand}" HorizontalAlignment="Left" />
      </StackPanel>
    </Border>
    <Border Classes="card">
      <StackPanel Spacing="8">
        <TextBlock Text="Or paste an invitation" Classes="subheading" />
        <StackPanel Classes="field" Margin="0">
          <TextBlock Name="InvitationLabel" Text="Pairing invitation (monitor-pair1...)" Classes="label" />
          <TextBox Text="{Binding InvitationText}" AcceptsReturn="False" TextWrapping="Wrap" AutomationProperties.LabeledBy="{Binding #InvitationLabel}" />
        </StackPanel>
        <Button Content="Pair with invitation" Command="{Binding PairWithInvitationCommand}" HorizontalAlignment="Left" />
      </StackPanel>
    </Border>
    </StackPanel>
    </Expander>
  </StackPanel></ScrollViewer>
</UserControl>
