<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MonitorApp.Client.Core.ViewModels"
             x:Class="MonitorApp.Client.Ui.Views.UpdatesView" x:DataType="vm:UpdatesViewModel">
  <ScrollViewer><StackPanel Spacing="8" Margin="12" MaxWidth="900" HorizontalAlignment="Stretch">
    <TextBlock Text="Updates" Classes="heading" />
    <TextBlock Text="{Binding InstalledText}" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock Text="{Binding StateText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    <Border Classes="card" IsVisible="{Binding NeedsRestart}">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding RestartText}" TextWrapping="Wrap" FontWeight="SemiBold" />
        <Button Name="RestartApp" Classes="action" Content="Restart Monitor App" Command="{Binding RestartAppCommand}" HorizontalAlignment="Left" />
      </StackPanel>
    </Border>
    <TextBlock Text="{Binding LastCheckedText}" TextWrapping="Wrap" />
    <TextBlock Text="{Binding CheckErrorText}" Classes="error" TextWrapping="Wrap" />
    <TextBlock Text="{Binding ErrorMessage}" Classes="error" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    <WrapPanel>
      <Button Content="Check for updates" Command="{Binding CheckCommand}" Margin="0,0,8,0" />
      <Button Content="{Binding InstallLabel}" Command="{Binding InstallCommand}" IsVisible="{Binding CanInstall}" />
    </WrapPanel>
  </StackPanel></ScrollViewer>
</UserControl>
