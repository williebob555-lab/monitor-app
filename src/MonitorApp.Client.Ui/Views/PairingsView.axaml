<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MonitorApp.Client.Core.ViewModels"
             x:Class="MonitorApp.Client.Ui.Views.PairingsView" x:DataType="vm:PairingsViewModel">
  <ScrollViewer><StackPanel Spacing="8" Margin="12" MaxWidth="900" HorizontalAlignment="Stretch">
    <TextBlock Text="Pairing and trust" Classes="heading" />
    <Button Content="Refresh" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" />
    <TextBlock Text="{Binding ErrorMessage}" Classes="error" AutomationProperties.LiveSetting="Assertive" />
    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    <Border Classes="card" IsVisible="{Binding CanShowPhonePairing}">
      <StackPanel Spacing="8">
        <TextBlock Text="Add a phone (show the QR code)" Classes="subheading" />
        <TextBlock TextWrapping="Wrap" Text="The QR code for your phone is on this computer's Monitor App page. Open it, choose Show a new pairing code under Add a phone, and scan it with the phone. Then approve the phone under Pending pairings." />
        <Button Name="OpenPhonePairing" Content="Open the phone pairing page" Click="OnOpenPhonePairing" HorizontalAlignment="Left" />
      </StackPanel>
    </Border>
    <TextBlock Text="Pairings" Classes="subheading" />
    <TextBlock Text="Compare the fingerprint with the one shown on the other device before approving." TextWrapping="Wrap" />
    <ItemsControl Name="PendingList" ItemsSource="{Binding Pending}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:PendingPairingRow">
          <Border Classes="card">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding PeerId, StringFormat='Peer id: {0}'}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Fingerprint, StringFormat='SHA-256 fingerprint: {0}'}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding ApprovalState, StringFormat='State: {0}'}" />
              <TextBlock Text="{Binding ExpiresAt, StringFormat='Expires: {0}'}" />
              <WrapPanel IsVisible="{Binding CanDecide}">
                <Button Content="Approve" Margin="0,0,8,0" Command="{Binding #PendingList.((vm:PairingsViewModel)DataContext).ApproveCommand}" CommandParameter="{Binding}"
                        AutomationProperties.Name="{Binding Name, StringFormat='Approve pairing with {0}'}" />
                <Button Content="Reject" Command="{Binding #PendingList.((vm:PairingsViewModel)DataContext).RejectCommand}" CommandParameter="{Binding}"
                        AutomationProperties.Name="{Binding Name, StringFormat='Reject pairing with {0}'}" />
              </WrapPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="Trusted and revoked peers" Classes="subheading" />
    <Border IsVisible="{Binding IsRevocationPending}" Classes="card alarm">
      <StackPanel Spacing="6">
        <TextBlock Text="{Binding RevocationPrompt}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
        <WrapPanel>
          <Button Content="Confirm revoke" Command="{Binding ConfirmRevokeCommand}" Margin="0,0,8,0" />
          <Button Content="Cancel" Command="{Binding CancelRevokeCommand}" />
        </WrapPanel>
      </StackPanel>
    </Border>
    <ItemsControl Name="PeerList" ItemsSource="{Binding Peers}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:TrustedPeerRow">
          <Border Classes="card">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding TrustState, StringFormat='Trust: {0}'}" />
              <TextBlock Text="{Binding Fingerprint, StringFormat='SHA-256 fingerprint: {0}'}" TextWrapping="Wrap" />
              <Button Content="Revoke trust..." IsVisible="{Binding CanRevoke}" HorizontalAlignment="Left"
                      Command="{Binding #PeerList.((vm:PairingsViewModel)DataContext).RequestRevokeCommand}" CommandParameter="{Binding}"
                      AutomationProperties.Name="{Binding Name, StringFormat='Revoke trust in {0}'}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="Phone permissions" Classes="subheading" IsVisible="{Binding CanGrant}" />
    <TextBlock IsVisible="{Binding CanGrant}" TextWrapping="Wrap"
               Text="A phone can do nothing on this computer until you allow it here. The switches show what is currently stored; Save sets them exactly as switched below. Saving a permission needs your fingerprint." />
    <ItemsControl Name="GrantList" ItemsSource="{Binding Grants}" IsVisible="{Binding CanGrant}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:PeerGrantViewModel">
          <Border Classes="card">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <CheckBox Name="MonitoringToggle" IsChecked="{Binding MonitoringControls}" AutomationProperties.Name="Monitoring controls">
                <TextBlock Text="{x:Static vm:PeerGrantViewModel.MonitoringCopy}" TextWrapping="Wrap" />
              </CheckBox>
              <CheckBox Name="PairingToggle" IsChecked="{Binding PairingApproval}" AutomationProperties.Name="Approve pairings">
                <TextBlock Text="{x:Static vm:PeerGrantViewModel.PairingCopy}" TextWrapping="Wrap" />
              </CheckBox>
              <CheckBox Name="UpdateToggle" IsChecked="{Binding UpdateApproval}" AutomationProperties.Name="Approve updates">
                <TextBlock Text="{x:Static vm:PeerGrantViewModel.UpdateCopy}" TextWrapping="Wrap" />
              </CheckBox>
              <TextBlock Name="LastChangedText" Text="{Binding LastChanged}" IsVisible="{Binding HasLastChanged}" />
              <Button Name="SaveGrantButton" Content="Save permissions" Command="{Binding SaveCommand}" HorizontalAlignment="Left"
                      AutomationProperties.Name="{Binding Name, StringFormat='Save permissions for {0}'}" />
              <TextBlock Text="{Binding ErrorMessage}" Classes="error" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
              <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel></ScrollViewer>
</UserControl>
