<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MonitorApp.Client.Core.ViewModels"
             xmlns:ctl="using:MonitorApp.Client.Ui.Controls"
             x:Class="MonitorApp.Client.Ui.Views.PairingsView" x:DataType="vm:PairingsViewModel">
  <ScrollViewer><StackPanel Spacing="8" Margin="12" MaxWidth="900" HorizontalAlignment="Stretch">
    <TextBlock Text="Add or remove devices" Classes="heading" />
    <ContentControl Content="{Binding Add}" IsVisible="{Binding CanAdd}" />
    <Button Content="Refresh" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" />
    <TextBlock Text="{Binding ErrorMessage}" Classes="error" AutomationProperties.LiveSetting="Assertive" />
    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    <Border Classes="card" IsVisible="{Binding CanAddPhone}">
      <StackPanel Spacing="8" DataContext="{Binding AddPhone}" x:DataType="vm:AddPhoneViewModel">
        <TextBlock Text="Add a device" Classes="subheading" />
        <TextBlock TextWrapping="Wrap" Text="Show this computer's code, then on the phone or tablet open Add or remove devices and tap Scan a code. Accept the request that appears below." />
        <TextBlock Text="{Binding ReachText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        <WrapPanel>
          <Button Content="Let my phone reach this computer" Command="{Binding TurnOnCommand}" IsVisible="{Binding CanTurnOn}" Margin="0,0,8,0" />
          <Button Content="Show my code" Command="{Binding ShowCodeCommand}" IsVisible="{Binding CanShowCode}" Margin="0,0,8,0" />
          <Button Content="Stop letting phones reach this computer" Command="{Binding TurnOffCommand}" IsVisible="{Binding CanTurnOff}" />
        </WrapPanel>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        <TextBlock Text="{Binding Error}" Classes="error" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
        <ctl:QrCodeView Rows="{Binding QrRows}" IsVisible="{Binding HasCode}" Width="264" Height="264" HorizontalAlignment="Left"
                        AutomationProperties.Name="QR code for pairing your phone" />
        <TextBlock Text="{Binding CodeText}" IsVisible="{Binding HasCode}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <TextBlock Text="Waiting for you to accept" Classes="subheading" />
    <TextBlock Text="Compare the fingerprint with the one shown on the other device before approving." TextWrapping="Wrap" />
    <ItemsControl Name="PendingList" ItemsSource="{Binding Pending}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:PendingPairingRow">
          <Border Classes="card">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding PeerId, StringFormat='Peer id: {0}'}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Fingerprint, StringFormat='SHA-256 fingerprint: {0}'}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding ApprovalState, StringFormat='State: {0}'}" />
              <TextBlock Text="{Binding ExpiresAt, StringFormat='Expires: {0}'}" />
              <WrapPanel IsVisible="{Binding CanDecide}">
                <Button Content="Approve" Margin="0,0,8,0" Command="{Binding #PendingList.((vm:PairingsViewModel)DataContext).ApproveCommand}" CommandParameter="{Binding}"
                        AutomationProperties.Name="{Binding Name, StringFormat='Approve pairing with {0}'}" />
                <Button Content="Reject" Command="{Binding #PendingList.((vm:PairingsViewModel)DataContext).RejectCommand}" CommandParameter="{Binding}"
                        AutomationProperties.Name="{Binding Name, StringFormat='Reject pairing with {0}'}" />
              </WrapPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="Trusted and revoked peers" Classes="subheading" />
    <TextBlock Text="{Binding RemovalCheck}" IsVisible="{Binding HasRemovalCheck}" Classes="muted" TextWrapping="Wrap" />
    <ItemsControl Name="PeerList" ItemsSource="{Binding Peers}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:TrustedPeerCard">
          <Border Classes="card">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding TrustState, StringFormat='Trust: {0}'}" />
              <TextBlock Text="{Binding Connection}" TextWrapping="Wrap" FontWeight="SemiBold" IsVisible="{Binding IsConnected}"
                         Foreground="{DynamicResource Brush.Healthy}" AutomationProperties.Name="{Binding Connection}" />
              <TextBlock Text="{Binding Connection}" TextWrapping="Wrap" FontWeight="SemiBold" IsVisible="{Binding IsNotConnected}"
                         Foreground="{DynamicResource Brush.Warning}" AutomationProperties.Name="{Binding Connection}" />
              <TextBlock Text="{Binding Provenance}" IsVisible="{Binding HasProvenance}" Classes="muted" TextWrapping="Wrap" />
              <TextBlock Text="{Binding PairedAt, StringFormat='Trusted since {0}'}" Classes="muted" />
              <TextBlock Text="{Binding Fingerprint, StringFormat='SHA-256 fingerprint: {0}'}" TextWrapping="Wrap" />
              <Button Content="Remove from all devices..." IsVisible="{Binding ShowRemoveButton}" HorizontalAlignment="Left"
                      Command="{Binding #PeerList.((vm:PairingsViewModel)DataContext).RequestRevokeCommand}" CommandParameter="{Binding}"
                      AutomationProperties.Name="{Binding Name, StringFormat='Remove {0} from all devices'}" />
              <!-- The question, progress and result of removing appear here, on the card that was pressed. -->
              <Border IsVisible="{Binding IsConfirming}" Classes="card alarm">
                <StackPanel Spacing="6">
                  <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                  <WrapPanel>
                    <Button Content="Remove" Margin="0,0,8,0" Command="{Binding #PeerList.((vm:PairingsViewModel)DataContext).ConfirmRevokeCommand}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Name, StringFormat='Yes, remove {0}'}" />
                    <Button Content="Cancel" Command="{Binding #PeerList.((vm:PairingsViewModel)DataContext).CancelRevokeCommand}" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsWorking}">
                <ProgressBar IsIndeterminate="True" Width="80" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" IsVisible="{Binding IsOutcomeOk}" AutomationProperties.LiveSetting="Polite" />
              <TextBlock Text="{Binding Outcome}" TextWrapping="Wrap" Classes="error" IsVisible="{Binding OutcomeFailed}" AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="Phone permissions" Classes="subheading" IsVisible="{Binding CanGrant}" />
    <TextBlock IsVisible="{Binding CanGrant}" TextWrapping="Wrap"
               Text="A phone can do nothing on this computer until you allow it here. The switches show what is currently stored; Save sets them exactly as switched below. Saving a permission needs your fingerprint when one is set up on this computer (Security)." />
    <ItemsControl Name="GrantList" ItemsSource="{Binding Grants}" IsVisible="{Binding CanGrant}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:PeerGrantViewModel">
          <Border Classes="card">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <CheckBox Name="MonitoringToggle" IsChecked="{Binding MonitoringControls}" AutomationProperties.Name="Monitoring controls">
                <TextBlock Text="{x:Static vm:PeerGrantViewModel.MonitoringCopy}" TextWrapping="Wrap" />
              </CheckBox>
              <CheckBox Name="PairingToggle" IsChecked="{Binding PairingApproval}" AutomationProperties.Name="Approve pairings">
                <TextBlock Text="{x:Static vm:PeerGrantViewModel.PairingCopy}" TextWrapping="Wrap" />
              </CheckBox>
              <CheckBox Name="UpdateToggle" IsChecked="{Binding UpdateApproval}" AutomationProperties.Name="Approve updates">
                <TextBlock Text="{x:Static vm:PeerGrantViewModel.UpdateCopy}" TextWrapping="Wrap" />
              </CheckBox>
              <TextBlock Name="LastChangedText" Text="{Binding LastChanged}" IsVisible="{Binding HasLastChanged}" />
              <Button Name="SaveGrantButton" Content="Save permissions" Command="{Binding SaveCommand}" HorizontalAlignment="Left"
                      AutomationProperties.Name="{Binding Name, StringFormat='Save permissions for {0}'}" />
              <TextBlock Text="{Binding ErrorMessage}" Classes="error" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
              <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel></ScrollViewer>
</UserControl>
