<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MonitorApp.Client.Core.ViewModels"
             xmlns:ctl="using:MonitorApp.Client.Ui.Controls"
             xmlns:ws="using:MonitorApp.Client.Ui.Workspace"
             xmlns:views="using:MonitorApp.Client.Ui.Views"
             x:Class="MonitorApp.Client.Ui.Views.EcosystemView" x:DataType="vm:EnvironmentViewModel">
  <!--
    The ecosystem workspace. WorkspaceHost is the extension slot for the schematic canvas (DataContext: EnvironmentViewModel).
    Until a canvas is plugged in (WorkspaceShell.WorkspaceTemplate), the host shows the structured outline, which stays
    available later as the screen-reader and keyboard alternative (the "Outline" panel beside the canvas).
  -->
  <!-- By default (no head template) the host shows the Dive (DiveView); the toolbar's outline switch brings the outline and inspector back. -->
  <UserControl.Resources>
    <!-- The map: the ecosystem as a graph of devices and typed connections. Selecting a device fills the inspector; the bar
         at the bottom dives into it or opens it up in Things. Drag a device to pin where it sits. -->
    <DataTemplate x:Key="MapTemplate" x:DataType="vm:EnvironmentViewModel">
      <Panel>
        <ws:SchematicCanvas Name="Map" Scene="{Binding Scene}" SelectedNodeId="{Binding SelectedNodeId, Mode=TwoWay}"
                            IsHistorical="{Binding IsHistorical}" NodeMovedCommand="{Binding PinNodeCommand}"
                            ReducedMotion="{Binding $parent[views:WorkspaceShell].ReducedMotion}"
                            AutomationProperties.Name="Map of devices and connections" />
        <Border Classes="tile" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Padding="12,8"
                IsVisible="{Binding SelectedNode, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding SelectedNode.Label, FallbackValue=''}" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="320" />
            <WrapPanel>
              <Button Classes="action" Content="Dive in" Margin="0,0,8,0"
                      Command="{Binding $parent[views:WorkspaceShell].((vm:MainViewModel)DataContext).Shell.DiveIntoSelectedCommand}"
                      AutomationProperties.Name="Dive into the selected device" />
              <Button Classes="action" Content="Open it up in Things"
                      IsVisible="{Binding $parent[views:WorkspaceShell].((vm:MainViewModel)DataContext).Shell.CanOpenInThings}"
                      Command="{Binding $parent[views:WorkspaceShell].((vm:MainViewModel)DataContext).Shell.OpenSelectedInThingsCommand}"
                      AutomationProperties.Name="Open the selected device in Things" />
            </WrapPanel>
          </StackPanel>
        </Border>
      </Panel>
    </DataTemplate>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,*">
    <StackPanel Name="Header" Grid.Row="0" Margin="12,8" Spacing="4">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Summary}" Classes="mono" VerticalAlignment="Center" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="Environment summary" />
        <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" Classes="compact"
                AutomationProperties.Name="Refresh the environment" />
      </Grid>
      <TextBlock Text="{Binding ErrorMessage}" Classes="error" AutomationProperties.LiveSetting="Assertive"
                 IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    </StackPanel>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
      <ContentControl Name="WorkspaceHost" Grid.Column="0" Content="{Binding}" AutomationProperties.Name="Workspace">
        <ContentControl.ContentTemplate>
          <DataTemplate x:DataType="vm:EnvironmentViewModel">
            <ctl:OutlineTree />
          </DataTemplate>
        </ContentControl.ContentTemplate>
      </ContentControl>
      <!-- With a canvas in the host, the outline moves here so it is never lost. -->
      <Border Name="OutlinePanel" Grid.Column="1" Classes="panel" BorderThickness="1,0,0,0" Width="280" IsVisible="False">
        <ctl:OutlineTree DataContext="{Binding}" />
      </Border>
    </Grid>
  </Grid>
</UserControl>
