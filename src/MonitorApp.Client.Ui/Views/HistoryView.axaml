<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MonitorApp.Client.Core.ViewModels"
             xmlns:ctl="using:MonitorApp.Client.Ui.Controls"
             xmlns:views="using:MonitorApp.Client.Ui.Views"
             x:Class="MonitorApp.Client.Ui.Views.HistoryView" x:DataType="vm:HistoryViewModel">
  <ScrollViewer>
    <StackPanel Spacing="8" Margin="12" MaxWidth="900" HorizontalAlignment="Stretch">
      <TextBlock Text="History" Classes="heading" />
      <WrapPanel>
        <StackPanel Classes="field">
          <TextBlock Name="SubjectLabel" Text="Subject" Classes="label" />
          <ComboBox ItemsSource="{Binding Picker.Subjects}" SelectedItem="{Binding Picker.SelectedSubject}" AutomationProperties.LabeledBy="{Binding #SubjectLabel}" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Name="SignalLabel" Text="Signal" Classes="label" />
          <ComboBox ItemsSource="{Binding Picker.Signals}" SelectedItem="{Binding Picker.SelectedSignal}" AutomationProperties.LabeledBy="{Binding #SignalLabel}">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="x:String"><TextBlock Text="{Binding Converter={x:Static ctl:DiveConverters.SignalLabel}}" /></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Name="RangeLabel" Text="Range" Classes="label" />
          <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" AutomationProperties.LabeledBy="{Binding #RangeLabel}" />
        </StackPanel>
      </WrapPanel>
      <WrapPanel IsVisible="{Binding IsCustom}">
        <StackPanel Classes="field">
          <TextBlock Name="FromLabel" Text="From" Classes="label" />
          <TextBox Text="{Binding CustomFrom}" Watermark="2026-11-21T10:00:00Z" AutomationProperties.LabeledBy="{Binding #FromLabel}" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Name="ToLabel" Text="To" Classes="label" />
          <TextBox Text="{Binding CustomTo}" Watermark="2026-11-21T12:00:00Z" AutomationProperties.LabeledBy="{Binding #ToLabel}" />
        </StackPanel>
      </WrapPanel>
      <WrapPanel>
        <Button Content="Load history" Command="{Binding LoadCommand}" IsDefault="True" Margin="0,0,8,0" />
        <Button Content="Reload catalog" Command="{Binding RefreshCommand}" />
      </WrapPanel>
      <TextBlock Text="{Binding ErrorMessage}" Classes="error" AutomationProperties.LiveSetting="Assertive" />
      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
      <ctl:LineChart Series="{Binding Chart}" Height="220" AutomationProperties.Name="History line chart" AutomationProperties.HelpText="{Binding ChartNote}" />
      <TextBlock Text="{Binding ChartNote}" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding DisplayRows}" AutomationProperties.Name="History readings">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ObservationRow"><views:ObservationCard /></DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
