<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MonitorApp.Client.Core.ViewModels"
             x:Class="MonitorApp.Client.Ui.Views.OverviewView" x:DataType="vm:OverviewViewModel">
  <ScrollViewer><StackPanel Spacing="8" Margin="12" MaxWidth="900" HorizontalAlignment="Stretch">
    <TextBlock Text="This device" Classes="heading" />
    <Button Content="Refresh" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" />
    <TextBlock Text="{Binding ErrorMessage}" Classes="error" AutomationProperties.LiveSetting="Assertive" />
    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    <WrapPanel IsVisible="{Binding HasHostControl}">
      <Button Content="Start monitoring" Command="{Binding StartHostCommand}" Margin="0,0,8,0" />
      <Button Content="Stop monitoring" Command="{Binding StopHostCommand}" />
    </WrapPanel>
    <Border Classes="card">
      <StackPanel Spacing="4">
        <TextBlock Text="Runtime" Classes="subheading" />
        <TextBlock Text="{Binding RuntimeStatus, StringFormat='Status: {0}'}" />
        <TextBlock Text="{Binding Scope}" TextWrapping="Wrap" />
        <TextBlock Text="Local peer" Classes="subheading" Margin="0,8,0,0" />
        <TextBlock Text="{Binding LocalPeerId, StringFormat='Peer id: {0}'}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding LocalFingerprint, StringFormat='SHA-256 fingerprint: {0}'}" TextWrapping="Wrap" />
        <TextBlock Text="{Binding PendingPairingCount, StringFormat='Pairings awaiting a decision or completion: {0}'}" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    <TextBlock Text="Trusted and revoked peers" Classes="subheading" />
    <ItemsControl ItemsSource="{Binding Peers}" AutomationProperties.Name="Trusted and revoked peers">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:TrustedPeerRow">
          <Border Classes="card">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Text="{Binding TrustState}" />
              <TextBlock Text="{Binding Fingerprint}" Classes="muted" FontSize="12" />
              <TextBlock Text="{Binding PairedAt, StringFormat='Paired: {0}'}" Classes="muted" FontSize="12" />
              <TextBlock Text="{Binding RevokedAt, StringFormat='Revoked: {0}'}" Classes="muted" FontSize="12" IsVisible="{Binding RevokedAt, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel></ScrollViewer>
</UserControl>
