<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MonitorApp.Client.Core.ViewModels"
             xmlns:views="using:MonitorApp.Client.Ui.Views"
             x:Class="MonitorApp.Client.Ui.Views.AsOfView" x:DataType="vm:AsOfViewModel">
  <ScrollViewer>
    <StackPanel Spacing="8" Margin="12" MaxWidth="900" HorizontalAlignment="Stretch">
      <TextBlock Text="State as of a moment" Classes="heading" />
      <WrapPanel>
        <StackPanel Classes="field">
          <TextBlock Name="SubjectLabel" Text="Subject" Classes="label" />
          <ComboBox ItemsSource="{Binding Picker.Subjects}" SelectedItem="{Binding Picker.SelectedSubject}" AutomationProperties.LabeledBy="{Binding #SubjectLabel}" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Name="SignalLabel" Text="Signal" Classes="label" />
          <ComboBox ItemsSource="{Binding Picker.Signals}" SelectedItem="{Binding Picker.SelectedSignal}" AutomationProperties.LabeledBy="{Binding #SignalLabel}" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Name="AsOfLabel" Text="As of" Classes="label" />
          <TextBox Text="{Binding AsOfText}" AutomationProperties.LabeledBy="{Binding #AsOfLabel}" />
        </StackPanel>
        <StackPanel Classes="field">
          <TextBlock Name="LookbackLabel" Text="Look back (hours)" Classes="label" />
          <TextBox Text="{Binding LookbackHoursText}" AutomationProperties.LabeledBy="{Binding #LookbackLabel}" />
        </StackPanel>
      </WrapPanel>
      <WrapPanel>
        <Button Content="Reconstruct" Command="{Binding LoadCommand}" IsDefault="True" Margin="0,0,8,0" />
        <Button Content="Reload catalog" Command="{Binding RefreshCommand}" />
      </WrapPanel>
      <TextBlock Text="{Binding ErrorMessage}" Classes="error" AutomationProperties.LiveSetting="Assertive" />
      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding Rows}" AutomationProperties.Name="State as of the chosen time">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ObservationRow"><views:ObservationCard /></DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
