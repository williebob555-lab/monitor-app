<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MonitorApp.Client.Core.ViewModels"
             xmlns:shell="using:MonitorApp.Client.Core.ViewModels.Shell"
             xmlns:views="using:MonitorApp.Client.Ui.Views"
             xmlns:ctl="using:MonitorApp.Client.Ui.Controls"
             x:Class="MonitorApp.Client.Ui.Views.WorkspaceShell"
             x:DataType="vm:MainViewModel">
  <UserControl.DataTemplates>
    <!-- One template per page view model. The ecosystem page hosts the schematic slot (see EcosystemView). -->
    <DataTemplate DataType="vm:EnvironmentViewModel"><views:EcosystemView /></DataTemplate>
    <DataTemplate DataType="shell:SearchViewModel"><views:SearchPageView /></DataTemplate>
    <DataTemplate DataType="vm:DevicesViewModel"><views:DevicesView /></DataTemplate>
    <DataTemplate DataType="vm:ThingsViewModel"><views:ThingsView /></DataTemplate>
    <DataTemplate DataType="vm:AlertsViewModel"><views:AlertsView /></DataTemplate>
    <DataTemplate DataType="vm:ActivityViewModel"><views:ActivityView /></DataTemplate>
    <DataTemplate DataType="vm:StateViewModel"><views:StateView /></DataTemplate>
    <DataTemplate DataType="vm:HistoryViewModel"><views:HistoryView /></DataTemplate>
    <DataTemplate DataType="vm:AsOfViewModel"><views:AsOfView /></DataTemplate>
    <DataTemplate DataType="vm:PairingsViewModel"><views:PairingsView /></DataTemplate>
    <DataTemplate DataType="vm:SecurityViewModel"><views:SecurityView /></DataTemplate>
    <DataTemplate DataType="vm:UpdatesViewModel"><views:UpdatesView /></DataTemplate>
    <DataTemplate DataType="vm:AlertPreferencesViewModel"><views:AlertPreferencesView /></DataTemplate>
    <DataTemplate DataType="vm:PairDeviceViewModel"><views:PairDeviceView /></DataTemplate>
    <DataTemplate DataType="vm:OverviewViewModel"><views:OverviewView /></DataTemplate>
  </UserControl.DataTemplates>
  <UserControl.Styles>
    <Style Selector="Border#InspectorHost.sheet.open">
      <Style.Animations>
        <Animation Duration="0:0:0.22" Easing="CubicEaseOut">
          <KeyFrame Cue="0%">
            <Setter Property="TranslateTransform.Y" Value="460" />
            <Setter Property="Opacity" Value="0.4" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="TranslateTransform.Y" Value="0" />
            <Setter Property="Opacity" Value="1" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="ListBox.nav > ListBoxItem" x:DataType="shell:ShellModeItem">
      <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
    </Style>
  </UserControl.Styles>

  <!-- The shell always runs in the dark graphite variant; the tokens in Theme/Tokens.axaml carry the identity. -->
  <ThemeVariantScope RequestedThemeVariant="Dark">
    <Panel Name="Root" Background="{DynamicResource Brush.Ink}" TextElement.Foreground="{DynamicResource Brush.Text}"
           TextElement.FontFamily="{DynamicResource Font.Sans}" TextElement.FontSize="{DynamicResource Size.Body}">
      <Grid Name="Frame" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,*,Auto,Auto">

        <!-- Left navigation rail: icon plus tooltip, collapsible to icons, active indicator. Wide and medium only. -->
        <Border Name="RailPanel" Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Classes="panel" BorderThickness="0,0,1,0"
                IsVisible="{Binding Shell.IsNotNarrow}">
          <DockPanel>
            <Button DockPanel.Dock="Top" Classes="compact flat" Command="{Binding Shell.ToggleRailCommand}" Margin="6,8,6,4"
                    HorizontalAlignment="Left" AutomationProperties.Name="Expand or collapse navigation" ToolTip.Tip="Expand or collapse navigation">
              <Path Classes="icon" Data="{StaticResource Icon.menu}" />
            </Button>
            <ListBox Name="Rail" Classes="nav" Classes.expanded="{Binding Shell.RailExpanded}" ItemsSource="{Binding Shell.Modes}"
                     SelectedItem="{Binding Shell.SelectedModeItem}" AutomationProperties.Name="Workspace modes">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="shell:ShellModeItem">
                  <StackPanel Orientation="Horizontal" Spacing="12" Margin="14,0,16,0" Background="Transparent"
                              ToolTip.Tip="{Binding Tooltip}">
                    <Path Classes="icon" Data="{Binding IconKey, Converter={x:Static ctl:ShellIcons.Icon}}" />
                    <TextBlock Classes="navlabel" Text="{Binding Title}" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>

        <!-- Thin top toolbar: breadcrumbs, search, LIVE / RECORDED pill, panel toggles. -->
        <Border Name="Toolbar" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Classes="panel" BorderThickness="0,0,0,1" MinHeight="48">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto" Margin="12,0,8,0">
            <ItemsControl Name="Breadcrumbs" Grid.Column="0" ItemsSource="{Binding Shell.Breadcrumbs}" IsVisible="{Binding Shell.IsNotNarrow}"
                          VerticalAlignment="Center" AutomationProperties.Name="Breadcrumbs">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="shell:BreadcrumbItem">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="›" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" IsVisible="{Binding ShowSeparator}"
                               AutomationProperties.AccessibilityView="Raw" />
                    <Button Classes="compact crumb" Content="{Binding Text}" FontWeight="SemiBold"
                            Command="{Binding #Root.((vm:MainViewModel)DataContext).Shell.SelectBreadcrumbCommand}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding Text, StringFormat='Breadcrumb {0}'}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel Grid.Column="0" IsVisible="{Binding Shell.IsNarrow}">
              <!-- Phone, inside the Dive: a back chip names where it climbs to (the breadcrumb trail does not fit). -->
              <Button Name="DiveBack" DockPanel.Dock="Left" Classes="compact flat" Command="{Binding Shell.Dive.BackCommand}"
                      IsVisible="{Binding Shell.ShowDiveBack}" Margin="-8,0,4,0"
                      AutomationProperties.Name="{Binding Shell.Dive.BackText, StringFormat='Back to {0}'}">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <Path Classes="icon" Data="{StaticResource Icon.back}" Width="16" Height="16" />
                  <TextBlock Text="{Binding Shell.Dive.BackText}" VerticalAlignment="Center" MaxWidth="110" TextTrimming="CharacterEllipsis"
                             Foreground="{DynamicResource Brush.TextSecondary}" />
                </StackPanel>
              </Button>
              <!-- Phone, on an alert page: the same chip climbs back to the Alerts home. -->
              <Button Name="AlertBack" DockPanel.Dock="Left" Classes="compact flat" Command="{Binding Shell.Alerts.BackCommand}"
                      IsVisible="{Binding Shell.ShowAlertBack}" Margin="-8,0,4,0" AutomationProperties.Name="Back to Alerts">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <Path Classes="icon" Data="{StaticResource Icon.back}" Width="16" Height="16" />
                  <TextBlock Text="Alerts" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" />
                </StackPanel>
              </Button>
              <!-- Phone, on an event page or a history tool: the chip climbs back to "What happened". -->
              <Button Name="ActivityBack" DockPanel.Dock="Left" Classes="compact flat" Command="{Binding Shell.Activity.BackCommand}"
                      IsVisible="{Binding Shell.ShowActivityBack}" Margin="-8,0,4,0" AutomationProperties.Name="Back to History">
                <StackPanel Orientation="Horizontal" Spacing="2">
                  <Path Classes="icon" Data="{StaticResource Icon.back}" Width="16" Height="16" />
                  <TextBlock Text="History" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextSecondary}" />
                </StackPanel>
              </Button>
              <TextBlock Name="NarrowTitle" Text="{Binding Shell.ToolbarTitle}" Classes="subheading" VerticalAlignment="Center"
                         IsVisible="{Binding Shell.IsNarrow}" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
            <TextBox Name="SearchBox" Grid.Column="1" Text="{Binding Shell.Search.Query}" Width="280" MinHeight="32" Margin="8,0"
                     Watermark="Search  (Ctrl+K)" IsVisible="{Binding Shell.IsNotNarrow}"
                     AutomationProperties.Name="Search devices, services and readings" />
            <Button Name="LivePill" Grid.Column="2" Classes="pill" Classes.historical="{Binding Shell.IsHistorical}"
                    Command="{Binding Shell.ToggleTimelineCommand}" Margin="4,0"
                    AutomationProperties.Name="{Binding Shell.LiveAccessibleText}" ToolTip.Tip="Show or hide the timeline">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Classes="marker" Data="{StaticResource Icon.live}" Fill="{DynamicResource Brush.Healthy}" Width="10" Height="10"
                      IsVisible="{Binding Shell.IsLive}" />
                <Path Classes="icon" Data="{StaticResource Icon.history}" Stroke="{DynamicResource Brush.Warning}" Width="14" Height="14"
                      IsVisible="{Binding Shell.IsHistorical}" />
                <TextBlock Name="LiveText" Text="{Binding Shell.LiveText}" FontFamily="{DynamicResource Font.Mono}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <!-- The map: every device as a card joined by its connections, with pan and zoom (the graph lens of the ecosystem). -->
            <Button Name="MapToggle" Grid.Column="3" Classes="compact flat" Command="{Binding Shell.ToggleMapCommand}"
                    Background="{Binding Shell.MapOpen, Converter={x:Static ctl:ShellIcons.ActiveBackground}}" IsVisible="{Binding Shell.ShowOutlineToggle}"
                    AutomationProperties.Name="Switch between the Dive and the map of devices and connections" ToolTip.Tip="Map of devices and connections">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Classes="icon" Data="{StaticResource Icon.map}" />
                <TextBlock Text="Map" VerticalAlignment="Center" IsVisible="{Binding Shell.IsNotNarrow}" />
              </StackPanel>
            </Button>
            <!-- The outline (with the inspector) is the keyboard and screen-reader alternative to the Dive. -->
            <Button Name="OutlineToggle" Grid.Column="4" Classes="compact flat" Command="{Binding Shell.ToggleOutlineCommand}"
                    Background="{Binding Shell.OutlineOpen, Converter={x:Static ctl:ShellIcons.ActiveBackground}}" IsVisible="{Binding Shell.ShowOutlineToggle}"
                    AutomationProperties.Name="Switch between the Dive and the outline with inspector" ToolTip.Tip="Outline view (accessible list)">
              <Path Classes="icon" Data="{StaticResource Icon.outline}" />
            </Button>
            <Button Name="InspectorToggle" Grid.Column="5" Classes="compact flat" Command="{Binding Shell.ToggleInspectorCommand}"
                    IsVisible="{Binding Shell.ShowInspectorToggle}" AutomationProperties.Name="Show or hide inspector" ToolTip.Tip="Show or hide inspector">
              <Path Classes="icon" Data="{StaticResource Icon.inspector}" />
            </Button>
            <Button Name="TimelineToggle" Grid.Column="6" Classes="compact flat" Command="{Binding Shell.ToggleTimelineCommand}"
                    IsVisible="{Binding Shell.IsNotNarrow}" AutomationProperties.Name="Show or hide timeline" ToolTip.Tip="Show or hide timeline">
              <Path Classes="icon" Data="{StaticResource Icon.timeline}" />
            </Button>
          </Grid>
        </Border>

        <!-- Main workspace: pages by mode, with the historical outline and the search drop-down laid over it. -->
        <Grid Name="Body" Grid.Row="1" Grid.Column="1">
          <DockPanel>
            <!-- What made the app stop (or what it caught and survived), shown once so it can be read and passed on. -->
            <Border Name="CrashBanner" DockPanel.Dock="Top" Classes="panel" BorderThickness="0,0,0,1" IsVisible="{Binding HasCrashNotice}">
              <DockPanel Margin="12,8">
                <Button DockPanel.Dock="Right" Content="Dismiss" Classes="compact flat" Command="{Binding DismissCrashNoticeCommand}"
                        VerticalAlignment="Top" AutomationProperties.Name="Dismiss the problem report" />
                <SelectableTextBlock Text="{Binding CrashNotice}" TextWrapping="Wrap" MaxHeight="160" Classes="meta" />
              </DockPanel>
            </Border>
            <!-- Dismissible, non-blocking: shown while fingerprint approval is not set up on this computer. -->
            <Border Name="FingerprintBanner" DockPanel.Dock="Top" Classes="panel" BorderThickness="0,0,0,1"
                    IsVisible="{Binding Security.ShowBanner, FallbackValue=False}">
              <DockPanel Margin="12,8">
                <Button DockPanel.Dock="Right" Name="DismissBannerButton" Content="Dismiss" Classes="compact flat" Command="{Binding Security.DismissBannerCommand}"
                        VerticalAlignment="Center" AutomationProperties.Name="Dismiss fingerprint notice" />
                <TextBlock Name="BannerText" Text="{x:Static vm:SecurityViewModel.BannerText}" TextWrapping="Wrap" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite" />
              </DockPanel>
            </Border>
            <Border DockPanel.Dock="Top" Classes="panel" BorderThickness="0,0,0,1" IsVisible="{Binding Shell.ShowsConnection}">
              <StackPanel Spacing="4" Margin="12,8">
                <WrapPanel IsVisible="{Binding ShowsAddress}">
                  <StackPanel Classes="field">
                    <TextBlock Name="AddressLabel" Text="Node address" Classes="label" />
                    <TextBox Name="AddressBox" Text="{Binding AddressText}" MinWidth="280" AutomationProperties.LabeledBy="{Binding #AddressLabel}" />
                  </StackPanel>
                  <Button Content="Connect" Command="{Binding ConnectCommand}" IsDefault="True" VerticalAlignment="Bottom" Margin="0,0,0,8"
                          AutomationProperties.Name="Connect to node address" />
                </WrapPanel>
                <TextBlock Text="{Binding AddressError}" Classes="error" IsVisible="{Binding AddressError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock Text="{Binding ConnectionStatus}" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" Classes="muted" />
              </StackPanel>
            </Border>
            <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          IsVisible="{Binding Shell.HasSubSections}">
              <TabStrip Name="SubTabs" ItemsSource="{Binding Shell.SubSections}" SelectedItem="{Binding Shell.SelectedSubSection}"
                        AutomationProperties.Name="Subsections">
                <TabStrip.ItemTemplate>
                  <DataTemplate x:DataType="vm:SectionViewModel"><TextBlock Text="{Binding Title}" VerticalAlignment="Center" /></DataTemplate>
                </TabStrip.ItemTemplate>
              </TabStrip>
            </ScrollViewer>
            <ctl:KeepAliveHost Name="PageHost" Content="{Binding Shell.Content}" />
          </DockPanel>

          <!-- Historical state outline: dashed frame plus words, so a recorded view can never pass for live. -->
          <Panel Name="HistoricalOutline" IsHitTestVisible="False" IsVisible="{Binding Shell.IsHistorical}">
            <Rectangle Stroke="{DynamicResource Brush.Warning}" StrokeThickness="2" StrokeDashArray="6,4" />
            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,8" Padding="8,2" Background="{DynamicResource Brush.Surface2}"
                    IsVisible="{Binding Shell.IsNotDive}"
                    BorderBrush="{DynamicResource Brush.Warning}" BorderThickness="1" CornerRadius="{DynamicResource Radius.Small}">
              <TextBlock Text="RECORDED VIEW · NOT LIVE" Classes="meta" Foreground="{DynamicResource Brush.Warning}" TextWrapping="NoWrap" />
            </Border>
          </Panel>

          <!-- Search drop-down for the toolbar box (wide and medium). -->
          <Border Name="SearchDropdown" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,12,0" Width="400" MaxHeight="360"
                  Classes="panel" BorderThickness="1" CornerRadius="{DynamicResource Radius.Medium}" ClipToBounds="True"
                  IsVisible="{Binding Shell.SearchDropdownOpen}">
            <ScrollViewer>
              <StackPanel>
                <TextBlock Text="{Binding Shell.Search.Status}" Classes="meta" Margin="12,8" AutomationProperties.LiveSetting="Polite" />
                <ItemsControl ItemsSource="{Binding Shell.Search.Results}" AutomationProperties.Name="Search results">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="shell:SearchResultRow">
                      <Button Classes="flat compact" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              Command="{Binding #Root.((vm:MainViewModel)DataContext).Shell.Search.JumpToCommand}" CommandParameter="{Binding}"
                              AutomationProperties.Name="{Binding AccessibleText}">
                        <Grid ColumnDefinitions="64,*">
                          <TextBlock Text="{Binding KindText}" Classes="section" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding Text}" Classes="mono" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>

        <!-- The one inspector. WorkspaceShell.ApplyLayout places it: docked right (wide), overlay panel (medium), bottom sheet (narrow). -->
        <Border Name="InspectorHost" Grid.Row="1" Grid.Column="2" Classes="panel" BorderThickness="1,0,0,0" Width="340"
                IsVisible="{Binding Shell.ShowInspector}" ClipToBounds="True">
          <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
          <views:InspectorView DataContext="{Binding Shell.Inspector}" />
        </Border>

        <!-- Bottom timeline strip: scrubber, persistent Return to live. -->
        <Border Name="TimelinePanel" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Classes="panel" BorderThickness="0,1,0,0"
                IsVisible="{Binding Shell.ShowTimeline}">
          <!-- In the Dive the strip is one slim row (scrubber, markers on the track, Live); elsewhere the taller panel. -->
          <views:TimelineView Name="Timeline" DataContext="{Binding Shell.Timeline}" Classes.slim="{Binding $parent[views:WorkspaceShell].((vm:MainViewModel)DataContext).Shell.IsDive}" />
        </Border>

        <!-- Phone: bottom navigation with the same modes (Ecosystem, Alerts, History, Search, More). -->
        <Border Name="BottomBar" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Classes="panel" BorderThickness="0,1,0,0"
                IsVisible="{Binding Shell.IsNarrow}">
          <ListBox Name="BottomNav" Classes="nav bottomnav" ItemsSource="{Binding Shell.Modes}" SelectedItem="{Binding Shell.SelectedModeItem}"
                   AutomationProperties.Name="Main sections">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="shell:ShellModeItem">
                <StackPanel Spacing="2" Margin="0,6" HorizontalAlignment="Center" Background="Transparent">
                  <Path Classes="icon" Data="{Binding IconKey, Converter={x:Static ctl:ShellIcons.Icon}}" HorizontalAlignment="Center" />
                  <TextBlock Classes="navlabel" Text="{Binding NarrowTitle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </Grid>
    </Panel>
  </ThemeVariantScope>
</UserControl>
