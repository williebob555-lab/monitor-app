<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MonitorApp.Client.Ui.MonitorUiStyles">
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://MonitorApp.Client.Ui/Theme/Tokens.axaml" />
        <ResourceInclude Source="avares://MonitorApp.Client.Ui/Theme/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>
  <FluentTheme />

  <!-- Base text: sans for prose and labels. Technical values opt in to .mono. -->
  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Sans}" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Fault}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.heading">
    <Setter Property="FontSize" Value="{DynamicResource Size.Heading}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.subheading">
    <Setter Property="FontSize" Value="{DynamicResource Size.Title}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="{DynamicResource Size.Small}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>
  <!-- Small technical annotation: uppercase section label, as on an engineering drawing. -->
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="{DynamicResource Size.Caption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.value">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
    <Setter Property="FontSize" Value="{DynamicResource Size.Title}" />
  </Style>
  <Style Selector="TextBlock.meta">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
    <Setter Property="FontSize" Value="{DynamicResource Size.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- Controls: flat, thin outlines, small radii. Touch targets stay at 44 px; .compact controls (dense desktop chrome)
       drop to 32 px and return to 44 px inside a narrow (phone) shell. -->
  <Style Selector="Button">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="MinWidth" Value="44" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Small}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{DynamicResource Size.Body}" />
  </Style>
  <Style Selector="Button.compact">
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="Padding" Value="8,4" />
  </Style>
  <Style Selector="Panel.narrow Button.compact">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="MinWidth" Value="44" />
  </Style>
  <Style Selector="Button.flat">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.flat:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
  </Style>
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Small}" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Small}" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="MinHeight" Value="48" />
  </Style>

  <!-- Thin outline instead of a filled card; no shadow. -->
  <Style Selector="Border.card">
    <Setter Property="Padding" Value="12" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Small}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Border.card.alarm">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Fault}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface1}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
  </Style>
  <Style Selector="Border.rule">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Brush.Line}" />
  </Style>
  <!-- A form field: label above the control, so forms work at phone width. -->
  <Style Selector="StackPanel.field">
    <Setter Property="Spacing" Value="4" />
    <Setter Property="Margin" Value="0,0,12,8" />
    <Setter Property="MinWidth" Value="200" />
  </Style>

  <!-- Status pill (LIVE / RECORDED). The recorded state differs by shape and words, not by colour alone. -->
  <Style Selector="Button.pill">
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Healthy}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,2" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
    <Setter Property="FontSize" Value="{DynamicResource Size.Small}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.pill.historical">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}" />
  </Style>
  <Style Selector="Panel.narrow Button.pill">
    <Setter Property="MinHeight" Value="44" />
  </Style>

  <!-- Navigation rail / bottom bar items: icon, optional label, active indicator. -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.nav > ListBoxItem">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel Background="Transparent">
          <Border Name="Bg" Margin="4,2" CornerRadius="{DynamicResource Radius.Small}" Background="{TemplateBinding Background}" />
          <Border Name="Indicator" Background="{DynamicResource Brush.Transfer}" />
          <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}"
                            VerticalContentAlignment="Center" />
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.nav > ListBoxItem /template/ Border#Indicator">
    <Setter Property="Width" Value="3" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Margin" Value="0,8" />
    <Setter Property="CornerRadius" Value="0,2,2,0" />
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ListBox.nav > ListBoxItem:pointerover /template/ Border#Bg">
    <Setter Property="Background" Value="{DynamicResource Brush.Hover}" />
  </Style>
  <Style Selector="ListBox.nav > ListBoxItem:selected /template/ Border#Bg">
    <Setter Property="Background" Value="{DynamicResource Brush.Selection}" />
  </Style>
  <Style Selector="ListBox.nav > ListBoxItem:selected /template/ Border#Indicator">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="ListBox.bottomnav > ListBoxItem /template/ Border#Indicator">
    <Setter Property="Width" Value="NaN" />
    <Setter Property="Height" Value="3" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Margin" Value="12,0" />
    <Setter Property="CornerRadius" Value="0,0,2,2" />
  </Style>
  <Style Selector="ListBox.nav TextBlock.navlabel">
    <Setter Property="FontSize" Value="{DynamicResource Size.Body}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ListBox.nav.expanded TextBlock.navlabel">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="ListBox.bottomnav TextBlock.navlabel">
    <Setter Property="IsVisible" Value="True" />
    <Setter Property="FontSize" Value="{DynamicResource Size.Small}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>
  <Style Selector="Path.icon">
    <Setter Property="Stroke" Value="{DynamicResource Brush.Text}" />
    <Setter Property="StrokeThickness" Value="1.6" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
  </Style>
  <Style Selector="Path.marker">
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <!-- Breadcrumbs, tabs and tree rows. -->
  <Style Selector="Button.crumb">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>
  <Style Selector="TabStrip">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="TabStripItem">
    <Setter Property="MinHeight" Value="44" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="FontSize" Value="{DynamicResource Size.Body}" />
  </Style>
  <Style Selector="TreeViewItem">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="IsExpanded" Value="True" />
  </Style>
  <Style Selector="ProgressBar.fill">
    <Setter Property="MinHeight" Value="4" />
    <Setter Property="Height" Value="4" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Background" Value="{DynamicResource Brush.Line}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Transfer}" />
  </Style>
</Styles>
