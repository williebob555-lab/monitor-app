# The shared Monitor folder on this server (inside your Syncthing-shared Infrastructure folder).
MONITOR_FOLDER=/home/wilson/Infrastructure/Monitor
# Your user and group numbers (run: id -u ; id -g). The collector writes files as you.
UID=1000
GID=1000
# Optional: the name shown in the app. Empty = this server's hostname.
NAME=
# latest = newest Monitor App release, or a number like 2.0.1
VERSION=latest
