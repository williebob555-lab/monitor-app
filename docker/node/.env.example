# Copy to .env, then edit the two values marked EDIT:   cp .env.example .env
COMPOSE_FILE=compose.yaml:compose.tailscale.yaml

# EDIT: the Monitor App release to run (a preview-<version> release on GitHub). After changing it:
#   docker compose up -d --build
MONITOR_APP_VERSION=0.1.35

# EDIT: this machine's Tailscale IPv4 address. Get it with:   tailscale ip -4
MONITOR_APP_PEER_BIND=100.x.y.z
