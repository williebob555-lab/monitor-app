[Unit]
Description=Monitor App peer node
Documentation=file:///usr/share/doc/monitor-app/README.packaging
After=network-online.target
Wants=network-online.target

[Service]
# UseSystemd() sends sd_notify READY=1 / STOPPING=1; logs go to the journal with priority prefixes.
Type=notify
User=monitor-app
Group=monitor-app
ExecStart=/opt/monitor-app/MonitorApp.Peer.Node
# Optional operator configuration (MONITOR_APP_PEER_BIND, MONITOR_APP_PEER_PORT, MONITOR_APP_ADMIN_PORT).
EnvironmentFile=-/etc/monitor-app/node.conf
# Identity key + SQLite state live in /var/lib/monitor-app (mode 0700, owned by monitor-app).
StateDirectory=monitor-app
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
# Failed identity/permission/platform startup exits non-zero; stop retry loops after a few attempts.
StartLimitIntervalSec=120
StartLimitBurst=5
TimeoutStopSec=30
Environment=DOTNET_NOLOGO=1
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=no
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
