[Unit]
Description=Monitor App privileged update installer
Documentation=file:///usr/share/doc/monitor-app/README.packaging
# Started by monitor-app-update.path when the unprivileged node writes an approved apply request.
# The helper trusts only the signed manifest and /etc/monitor-app/update-key.json, never the request body.

[Service]
Type=oneshot
User=root
ExecStart=/opt/monitor-app/MonitorApp.Peer.Node --apply-update /var/lib/monitor-app/update
EnvironmentFile=-/etc/monitor-app/node.conf
# Root-owned work directory: private copy of the package and the retained last-known-good package.
StateDirectory=monitor-app-helper
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=900
Environment=DOTNET_NOLOGO=1
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
