#!/bin/sh
set -e
# remove: binaries go, identity key and data stay. purge: identity, data, config and user go.
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi
if [ "$1" = "purge" ]; then
    rm -rf /var/lib/monitor-app /etc/monitor-app
    if getent passwd monitor-app >/dev/null 2>&1; then
        deluser --system monitor-app >/dev/null 2>&1 || true
    fi
    if getent group monitor-app >/dev/null 2>&1; then
        delgroup --system monitor-app >/dev/null 2>&1 || true
    fi
fi
exit 0
