#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
    if ! getent passwd monitor-app >/dev/null 2>&1; then
        adduser --system --group --home /var/lib/monitor-app --no-create-home \
            --shell /usr/sbin/nologin --gecos "Monitor App peer node" monitor-app
    fi
    # Created here too so the package works without systemd (StateDirectory= does the same under systemd).
    install -d -m 0700 -o monitor-app -g monitor-app /var/lib/monitor-app
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload >/dev/null 2>&1 || true
        # Not enabled/started automatically: the operator reviews /etc/monitor-app/node.conf first.
        echo "monitor-app installed. Review /etc/monitor-app/node.conf, then: systemctl enable --now monitor-app"
    fi
fi
exit 0
