<!--
  Windows installer (MSI) for Monitor App: node service + desktop app. Built by build-msi.ps1 with WiX v5.
  The MSI lays the release files down in "%ProgramFiles%\Monitor App Setup" and then runs the same
  Install-MonitorApp.ps1 the zip uses (under Windows PowerShell 5.1, no PowerShell 7 needed), so an MSI install
  and a zip install end in the identical side-by-side layout that in-app updates manage. Reinstalling or
  upgrading keeps the node identity and data. Uninstall removes the service and binaries and keeps the data.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Monitor App" Manufacturer="Monitor App" Version="$(var.Version)"
           UpgradeCode="{6C0B5E7A-3F1D-4C9B-9E1A-5D2F8B7C4A10}" Scope="perMachine" Compressed="yes">
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer Monitor App is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="SETUPDIR" Name="Monitor App Setup" />
    </StandardDirectory>

    <Feature Id="Main" Title="Monitor App">
      <Files Directory="SETUPDIR" Include="$(var.StageDir)\**" />
    </Feature>

    <SetProperty Id="RunInstaller" Sequence="execute" Before="RunInstaller"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[SETUPDIR]Install-MonitorApp.ps1&quot;" />
    <CustomAction Id="RunInstaller" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="check" />

    <SetProperty Id="RunUninstaller" Sequence="execute" Before="RunUninstaller"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[SETUPDIR]uninstall-service.ps1&quot;" />
    <CustomAction Id="RunUninstaller" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec" Execute="deferred" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="RunUninstaller" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RunInstaller" Before="InstallFinalize" Condition="NOT REMOVE" />
    </InstallExecuteSequence>
  </Package>
</Wix>
